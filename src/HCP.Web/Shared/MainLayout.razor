@inherits LayoutComponentBase

<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />
@* Bắt buộc cho các component bung ra ngoài luồng (MudSelect, MudDatePicker, MudMenu...).
   Thiếu nó thì mở dialog có MudSelect sẽ ném lỗi và làm hỏng circuit. *@
<MudPopoverProvider />

<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Primary">
        <MudText Typo="Typo.h6">Quản lý quy trình sản xuất</MudText>
        <MudSpacer />
        <AuthorizeView>
            <Authorized>
                <MudText Typo="Typo.body2" Class="mr-4">
                    @context.User.Identity?.Name
                </MudText>
                <MudButton Href="/dang-xuat" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Logout">
                    Đăng xuất
                </MudButton>
            </Authorized>
            <NotAuthorized>
                <MudButton Href="/dang-nhap" Color="Color.Inherit">Đăng nhập</MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer Open="true" Elevation="1" Variant="DrawerVariant.Mini" OpenMiniOnHover="true">
        <NavMenu />
    </MudDrawer>

    @* Chỉ đặt padding hai bên và dưới. Dùng "pa-6" sẽ ghi đè luôn padding-top mà
       MudMainContent tự tính để chừa chỗ cho AppBar cố định, khiến nội dung
       (kể cả các nút thao tác) chui xuống dưới thanh tiêu đề. *@
    <MudMainContent Class="px-6 pb-6">
        @Body
    </MudMainContent>
</MudLayout>
