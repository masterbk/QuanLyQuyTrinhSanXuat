@inherits LayoutComponentBase

<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Primary">
        <MudText Typo="Typo.h6">Quản lý quy trình sản xuất</MudText>
        <MudSpacer />
        <AuthorizeView>
            <Authorized>
                <MudText Typo="Typo.body2" Class="mr-4">
                    @context.User.Identity?.Name
                </MudText>
                <MudButton Href="/dang-xuat" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Logout">
                    Đăng xuất
                </MudButton>
            </Authorized>
            <NotAuthorized>
                <MudButton Href="/dang-nhap" Color="Color.Inherit">Đăng nhập</MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer Open="true" Elevation="1" Variant="DrawerVariant.Mini" OpenMiniOnHover="true">
        <NavMenu />
    </MudDrawer>

    <MudMainContent Class="pa-6">
        @Body
    </MudMainContent>
</MudLayout>
