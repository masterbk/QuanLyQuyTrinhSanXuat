@using HCP.Domain.Constants

@* Menu theo vai trò; người nhiều vai trò thấy gộp các mục. AuthorizeView lồng nhau phải đặt Context riêng.
   ChiKhiCoChucNang: chức năng (menu) mà quản trị nền tảng mở cho cơ sở - xem ChucNang, chồng lên vai trò.
   Mỗi mục menu bọc một mã riêng: NCC suất ăn tắt được Lệnh sản xuất mà vẫn giữ Tồn kho. *@
<MudNavMenu>
    <AuthorizeView Roles="@AppRoles.PlatformSuperAdmin">
        <MudNavLink Href="/admin/dashboard" Icon="@Icons.Material.Filled.Dashboard">
            Giám sát hệ thống
        </MudNavLink>
        <MudNavLink Href="/admin/duyet-dang-ky" Icon="@Icons.Material.Filled.FactCheck">
            Duyệt đăng ký
        </MudNavLink>
        <MudNavLink Href="/admin/co-so" Icon="@Icons.Material.Filled.Domain">
            Danh sách cơ sở
        </MudNavLink>
    </AuthorizeView>

    <AuthorizeView Roles="@AppRoles.QuyenNhapLieu" Context="nhapLieu">
        @* Tổng quan luôn mở - không có mã chức năng. *@
        <MudNavLink Href="/app/dashboard" Icon="@Icons.Material.Filled.Dashboard">
            Tổng quan
        </MudNavLink>
        <MudNavGroup Title="Danh mục" Icon="@Icons.Material.Filled.ListAlt" Expanded="true">
            <ChiKhiCoChucNang Ma="@ChucNang.Kho">
                <MudNavLink Href="/app/kho" Icon="@Icons.Material.Filled.Warehouse">
                    Kho
                </MudNavLink>
            </ChiKhiCoChucNang>
            <ChiKhiCoChucNang Ma="@ChucNang.CoSoSanXuat">
                <MudNavLink Href="/app/co-so-san-xuat" Icon="@Icons.Material.Filled.Factory">
                    Cơ sở sản xuất
                </MudNavLink>
            </ChiKhiCoChucNang>
            <ChiKhiCoChucNang Ma="@ChucNang.KhauSanXuat">
                <MudNavLink Href="/app/khau-san-xuat" Icon="@Icons.Material.Filled.Timeline">
                    Khâu sản xuất
                </MudNavLink>
            </ChiKhiCoChucNang>
            <ChiKhiCoChucNang Ma="@ChucNang.QuyTrinh">
                <MudNavLink Href="/app/quy-trinh" Icon="@Icons.Material.Filled.AccountTree">
                    Quy trình sản xuất
                </MudNavLink>
            </ChiKhiCoChucNang>
            <ChiKhiCoChucNang Ma="@ChucNang.NccDauVao">
                <MudNavLink Href="/app/ncc-dau-vao" Icon="@Icons.Material.Filled.LocalShipping">
                    Nhà cung ứng đầu vào
                </MudNavLink>
            </ChiKhiCoChucNang>
            <ChiKhiCoChucNang Ma="@ChucNang.NhanSu">
                <MudNavLink Href="/app/nhan-su" Icon="@Icons.Material.Filled.Badge">
                    Nhân sự
                </MudNavLink>
            </ChiKhiCoChucNang>
            <ChiKhiCoChucNang Ma="@ChucNang.ThucPham">
                <MudNavLink Href="/app/thuc-pham" Icon="@Icons.Material.Filled.Fastfood">
                    Thực phẩm / SKU
                </MudNavLink>
            </ChiKhiCoChucNang>
            <ChiKhiCoChucNang Ma="@ChucNang.LoSanXuat">
                <MudNavLink Href="/app/lo-san-xuat" Icon="@Icons.Material.Filled.Inventory2">
                    Lô sản xuất
                </MudNavLink>
            </ChiKhiCoChucNang>
            <ChiKhiCoChucNang Ma="@ChucNang.MonAn">
                <MudNavLink Href="/app/mon-an" Icon="@Icons.Material.Filled.RestaurantMenu">
                    Món ăn
                </MudNavLink>
            </ChiKhiCoChucNang>
            <ChiKhiCoChucNang Ma="@ChucNang.ThucDon">
                <MudNavLink Href="/app/thuc-don" Icon="@Icons.Material.Filled.MenuBook">
                    Thực đơn
                </MudNavLink>
            </ChiKhiCoChucNang>
        </MudNavGroup>
    </AuthorizeView>

    @* Biểu mẫu kiểm soát: nhân viên nhập biểu mẫu chỉ thấy Nhập phiếu + Phiếu ghi nhận (mẫu được giao). *@
    <AuthorizeView Roles="@AppRoles.QuyenBieuMau" Context="bieuMau">
        <MudNavGroup Title="Kiểm soát ATTP" Icon="@Icons.Material.Filled.Assignment" Expanded="true">
            <ChiKhiCoChucNang Ma="@ChucNang.NhapPhieu">
                <MudNavLink Href="/app/nhap-phieu" Icon="@Icons.Material.Filled.EditNote">
                    Nhập phiếu
                </MudNavLink>
            </ChiKhiCoChucNang>
            <ChiKhiCoChucNang Ma="@ChucNang.PhieuGhiNhan">
                <MudNavLink Href="/app/phieu-ghi-nhan" Icon="@Icons.Material.Filled.FactCheck">
                    Phiếu ghi nhận
                </MudNavLink>
            </ChiKhiCoChucNang>
            <AuthorizeView Roles="@AppRoles.QuyenNhapLieu" Context="cauHinhBm">
                <ChiKhiCoChucNang Ma="@ChucNang.BieuMau">
                    <MudNavLink Href="/app/bieu-mau" Icon="@Icons.Material.Filled.Assignment">
                        Biểu mẫu kiểm soát
                    </MudNavLink>
                </ChiKhiCoChucNang>
                <ChiKhiCoChucNang Ma="@ChucNang.NhacHan">
                    <MudNavLink Href="/app/nhac-han" Icon="@Icons.Material.Filled.NotificationsActive">
                        Nhắc hạn thiết bị
                    </MudNavLink>
                </ChiKhiCoChucNang>
            </AuthorizeView>
        </MudNavGroup>
    </AuthorizeView>

    <AuthorizeView Roles="@AppRoles.QuyenSanXuat" Context="sanXuat">
        <MudNavGroup Title="Kho & Sản xuất" Icon="@Icons.Material.Filled.Inventory" Expanded="true">
            <ChiKhiCoChucNang Ma="@ChucNang.TonKho">
                <MudNavLink Href="/app/kho-noi-bo" Icon="@Icons.Material.Filled.Warehouse">
                    Tồn kho &amp; nhập
                </MudNavLink>
            </ChiKhiCoChucNang>
            <AuthorizeView Roles="@AppRoles.QuyenNhapLieu" Context="dinhMuc">
                <ChiKhiCoChucNang Ma="@ChucNang.DinhMuc">
                    <MudNavLink Href="/app/dinh-muc" Icon="@Icons.Material.Filled.Rule">
                        Định mức
                    </MudNavLink>
                </ChiKhiCoChucNang>
            </AuthorizeView>
            <ChiKhiCoChucNang Ma="@ChucNang.LenhSanXuat">
                <MudNavLink Href="/app/lenh-san-xuat" Icon="@Icons.Material.Filled.Factory">
                    Lệnh sản xuất
                </MudNavLink>
            </ChiKhiCoChucNang>
        </MudNavGroup>
    </AuthorizeView>

    <AuthorizeView Roles="@AppRoles.QuyenGiaoHang" Context="giaoHang">
        <MudNavGroup Title="Bán hàng" Icon="@Icons.Material.Filled.PointOfSale" Expanded="true">
            <AuthorizeView Roles="@AppRoles.QuyenNhapLieu" Context="khachHang">
                <ChiKhiCoChucNang Ma="@ChucNang.KhachHang">
                    <MudNavLink Href="/app/khach-hang" Icon="@Icons.Material.Filled.People">
                        Khách hàng
                    </MudNavLink>
                </ChiKhiCoChucNang>
            </AuthorizeView>
            <ChiKhiCoChucNang Ma="@ChucNang.DonHangBan">
                <MudNavLink Href="/app/don-hang-ban" Icon="@Icons.Material.Filled.ReceiptLong">
                    Đơn hàng bán
                </MudNavLink>
            </ChiKhiCoChucNang>
            <AuthorizeView Roles="@AppRoles.QuyenNhapLieu" Context="donTruong">
                <ChiKhiCoChucNang Ma="@ChucNang.DonHangNhan">
                    <ChiKhiBatHnC>
                        <MudNavLink Href="/app/don-hang-nhan" Icon="@Icons.Material.Filled.CloudDownload">
                            Đơn hàng từ trường (HanoiCheck)
                        </MudNavLink>
                    </ChiKhiBatHnC>
                </ChiKhiCoChucNang>
            </AuthorizeView>
        </MudNavGroup>
    </AuthorizeView>

    <AuthorizeView Roles="@AppRoles.QuyenNhapLieu" Context="nhatKy">
        <ChiKhiCoChucNang Ma="@ChucNang.NhatKyDongBo">
            <ChiKhiBatHnC>
                <MudNavLink Href="/app/nhat-ky-dong-bo" Icon="@Icons.Material.Filled.Sync">
                    Nhật ký đồng bộ
                </MudNavLink>
            </ChiKhiBatHnC>
        </ChiKhiCoChucNang>
    </AuthorizeView>

    <AuthorizeView Roles="@AppRoles.TenantAdmin" Context="quanTri">
        <ChiKhiCoChucNang Ma="@ChucNang.KetNoiHnC">
            <MudNavLink Href="/app/cai-dat-ket-noi" Icon="@Icons.Material.Filled.Link">
                Cài đặt kết nối HanoiCheck
            </MudNavLink>
            <ChiKhiBatHnC>
                <MudNavLink Href="/app/kiem-tra-api" Icon="@Icons.Material.Filled.Api">
                    Kiểm tra API HanoiCheck
                </MudNavLink>
            </ChiKhiBatHnC>
        </ChiKhiCoChucNang>
    </AuthorizeView>
</MudNavMenu>
