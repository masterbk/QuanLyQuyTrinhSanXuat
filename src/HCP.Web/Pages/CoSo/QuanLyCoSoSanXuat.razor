@page "/app/co-so-san-xuat"
@using HCP.Domain.Constants
@using HCP.Domain.Entities.Business
@using HCP.Infrastructure.Services.DanhMuc
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = AppRoles.TenantAdmin + "," + AppRoles.TenantStaff)]
@inject IDanhMucService<Facility> CoSoSanXuatService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Cơ sở sản xuất</PageTitle>

<div class="d-flex justify-space-between align-center mb-4">
    <div>
        <MudText Typo="Typo.h5">Cơ sở sản xuất / chế biến</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            Các địa điểm sản xuất thuộc đơn vị bạn (bếp, xưởng, nơi giết mổ...).
        </MudText>
    </div>
    <MudButton Variant="Variant.Filled" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => MoForm(null))">
        Thêm cơ sở
    </MudButton>
</div>

@if (_dangTai)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_danhSach.Count == 0)
{
    <MudAlert Severity="Severity.Info">
        Chưa có cơ sở sản xuất nào. Lô sản xuất và món ăn sẽ cần tham chiếu tới mã cơ sở khai ở đây.
    </MudAlert>
}
else
{
    <MudTable Items="_danhSach" Hover="true" Elevation="1" Dense="true">
        <HeaderContent>
            <MudTh Style="width:56px">STT</MudTh>
            <MudTh>Mã cơ sở</MudTh>
            <MudTh>Tên cơ sở</MudTh>
            <MudTh>Địa chỉ</MudTh>
            <MudTh Style="width:120px"></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="STT">@(_danhSach.IndexOf(context)+1)</MudTd>
            <MudTd DataLabel="Mã cơ sở"><b>@context.MaCoSo</b></MudTd>
            <MudTd DataLabel="Tên cơ sở">@context.TenCoSo</MudTd>
            <MudTd DataLabel="Địa chỉ">@context.DiaChi</MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                               OnClick="@(() => MoForm(context))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                               OnClick="@(() => XacNhanXoaAsync(context))" />
            </MudTd>
        </RowTemplate>
    </MudTable>
}

<MudDialog @bind-Visible="_hienForm" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">@(_dangSua ? "Sửa cơ sở" : "Thêm cơ sở")</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" Model="_input">
            <MudTextField @bind-Value="_input.MaCoSo" Label="Mã cơ sở" Class="mb-3"
                          Variant="Variant.Outlined" MaxLength="255"
                          HelperText="Khoá nghiệp vụ đối chiếu với HanoiCheck, vd CS001."
                          Required="true" RequiredError="Vui lòng nhập mã cơ sở" />

            <MudTextField @bind-Value="_input.TenCoSo" Label="Tên cơ sở" Class="mb-3"
                          Variant="Variant.Outlined" MaxLength="255"
                          Required="true" RequiredError="Vui lòng nhập tên cơ sở" />

            <MudTextField @bind-Value="_input.DiaChi" Label="Địa chỉ"
                          Variant="Variant.Outlined" MaxLength="255"
                          HelperText="Không bắt buộc." />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _hienForm = false)">Huỷ</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   Disabled="_dangLuu" OnClick="LuuAsync">Lưu</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<Facility> _danhSach = new();
    private bool _dangTai = true;
    private bool _dangLuu;

    private MudForm? _form;
    private bool _hienForm;
    private bool _dangSua;
    private Facility _input = new();

    private readonly DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true };

    protected override async Task OnInitializedAsync() => await TaiDanhSachAsync();

    private async Task TaiDanhSachAsync()
    {
        _dangTai = true;
        _danhSach = (await CoSoSanXuatService.LayTatCaAsync()).ToList();
        _dangTai = false;
    }

    private void MoForm(Facility? coSo)
    {
        _dangSua = coSo is not null;

        _input = coSo is null
            ? new Facility()
            : new Facility
            {
                Id = coSo.Id,
                MaCoSo = coSo.MaCoSo,
                TenCoSo = coSo.TenCoSo,
                DiaChi = coSo.DiaChi
            };

        _hienForm = true;
    }

    private async Task LuuAsync()
    {
        if (_form is not null)
        {
            await _form.Validate();
            if (!_form.IsValid) return;
        }

        _dangLuu = true;
        var ketQua = _dangSua
            ? await CoSoSanXuatService.CapNhatAsync(_input)
            : await CoSoSanXuatService.ThemAsync(_input);
        _dangLuu = false;

        Snackbar.Add(ketQua.ThongBao, ketQua.ThanhCong ? Severity.Success : Severity.Error);

        if (ketQua.ThanhCong)
        {
            _hienForm = false;
            await TaiDanhSachAsync();
        }
    }

    private async Task XacNhanXoaAsync(Facility coSo)
    {
        var dongY = await DialogService.ShowMessageBox(
            "Xác nhận xoá",
            $"Xoá cơ sở \"{coSo.TenCoSo}\" ({coSo.MaCoSo})?",
            yesText: "Xoá", cancelText: "Huỷ");

        if (dongY != true) return;

        var ketQua = await CoSoSanXuatService.XoaAsync(coSo.Id);
        Snackbar.Add(ketQua.ThongBao, ketQua.ThanhCong ? Severity.Success : Severity.Error);

        if (ketQua.ThanhCong) await TaiDanhSachAsync();
    }
}
