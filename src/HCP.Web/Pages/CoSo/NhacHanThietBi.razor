@page "/app/nhac-han"
@using HCP.Domain.Constants
@using HCP.Infrastructure.Services.BieuMau
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = AppRoles.QuyenNhapLieu)]
@inject IBieuMauService BieuMauService

<PageTitle>Nhắc hạn thiết bị</PageTitle>

<div class="mb-4">
    <MudText Typo="Typo.h5">Nhắc hạn hiệu chuẩn / bảo dưỡng</MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary">
        Các thiết bị/dòng đã đến hoặc sắp đến hạn (theo trường "Hạn nhắc" trong biểu mẫu). Quá hạn hiển thị màu đỏ.
    </MudText>
</div>

<div class="d-flex flex-wrap gap-2 align-center mb-3">
    <MudSelect T="int" Value="_soNgay" ValueChanged="DoiSoNgay" Label="Trong vòng" Variant="Variant.Outlined"
               Margin="Margin.Dense" Style="width:200px">
        <MudSelectItem T="int" Value="7">7 ngày tới</MudSelectItem>
        <MudSelectItem T="int" Value="30">30 ngày tới</MudSelectItem>
        <MudSelectItem T="int" Value="60">60 ngày tới</MudSelectItem>
        <MudSelectItem T="int" Value="90">90 ngày tới</MudSelectItem>
    </MudSelect>
    <MudChip T="string" Color="Color.Error" Variant="Variant.Text">Quá hạn: @_soQuaHan</MudChip>
    <MudChip T="string" Color="Color.Warning" Variant="Variant.Text">Sắp đến hạn: @(_ds.Count - _soQuaHan)</MudChip>
</div>

@if (_dangTai)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_ds.Count == 0)
{
    <MudAlert Severity="Severity.Success">Không có thiết bị nào đến hạn trong khoảng đã chọn.</MudAlert>
}
else
{
    <MudTable Items="_ds" Hover="true" Dense="true" Elevation="1">
        <HeaderContent>
            <MudTh>Thiết bị / dòng</MudTh>
            <MudTh>Biểu mẫu</MudTh>
            <MudTh>Loại hạn</MudTh>
            <MudTh>Hạn</MudTh>
            <MudTh Style="text-align:center">Còn lại</MudTh>
            <MudTh Style="width:1%"></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Thiết bị"><b>@context.Nhan</b></MudTd>
            <MudTd DataLabel="Biểu mẫu">@context.TenBieuMau</MudTd>
            <MudTd DataLabel="Loại hạn">@context.TenTruong</MudTd>
            <MudTd DataLabel="Hạn">@context.Han.ToString("dd/MM/yyyy")</MudTd>
            <MudTd DataLabel="Còn lại" Style="text-align:center">
                @if (context.SoNgayConLai < 0)
                {
                    <MudChip T="string" Color="Color.Error" Size="Size.Small">Quá @(-context.SoNgayConLai) ngày</MudChip>
                }
                else if (context.SoNgayConLai == 0)
                {
                    <MudChip T="string" Color="Color.Error" Size="Size.Small">Hôm nay</MudChip>
                }
                else
                {
                    <MudChip T="string" Color="Color.Warning" Size="Size.Small">Còn @context.SoNgayConLai ngày</MudChip>
                }
            </MudTd>
            <MudTd>
                <MudTooltip Text="Mở phiếu (PDF)">
                    <MudIconButton Icon="@Icons.Material.Filled.PictureAsPdf" Color="Color.Error" Size="Size.Small"
                                   Href="@($"/app/phieu/{context.PhieuId}/pdf")" Target="_blank" />
                </MudTooltip>
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private List<NhacHan> _ds = new();
    private bool _dangTai = true;
    private int _soNgay = 30;
    private int _soQuaHan;

    protected override async Task OnInitializedAsync() => await TaiAsync();

    private async Task TaiAsync()
    {
        _dangTai = true;
        _ds = (await BieuMauService.LayNhacHanAsync(_soNgay)).ToList();
        _soQuaHan = _ds.Count(x => x.SoNgayConLai < 0);
        _dangTai = false;
    }

    private async Task DoiSoNgay(int v) { _soNgay = v; await TaiAsync(); }
}
