@page "/app/don-hang"
@using HCP.Domain.Constants
@using HCP.Domain.Entities.Business
@using HCP.Infrastructure.Services.DanhMuc
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = AppRoles.TenantAdmin + "," + AppRoles.TenantStaff)]
@inject IDanhMucService<Order> DonHangService
@inject IDanhMucService<Dish> MonAnService
@inject IDanhMucService<Product> ThucPhamService
@inject IDanhMucService<Warehouse> KhoService
@inject IDanhMucService<Batch> LoService
@inject IDanhMucService<Staff> NhanSuService
@inject IDanhMucChuanService DanhMucChuanService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Quản lý đơn hàng</PageTitle>

<div class="d-flex justify-space-between align-center mb-4">
    <div>
        <MudText Typo="Typo.h5">Quản lý đơn hàng &amp; xuất kho</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            Đơn thực phẩm (kèm xuất kho) hoặc đơn món ăn. Đồng bộ qua nghiệp vụ "Đồng bộ đơn hàng".
        </MudText>
    </div>
    <MudButton Variant="Variant.Filled" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => MoForm(null))">
        Thêm đơn hàng
    </MudButton>
</div>

@if (_dangTai)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_danhSach.Count == 0)
{
    <MudAlert Severity="Severity.Info">Chưa có đơn hàng nào.</MudAlert>
}
else
{
    <MudTable Items="_danhSach" Hover="true" Elevation="1" Dense="true">
        <HeaderContent>
            <MudTh Style="width:56px">STT</MudTh>
            <MudTh>Mã đơn</MudTh>
            <MudTh>Loại</MudTh>
            <MudTh>Trường</MudTh>
            <MudTh>Ngày</MudTh>
            <MudTh>Trạng thái</MudTh>
            <MudTh Style="text-align:center">Dòng / Xuất kho</MudTh>
            <MudTh Style="width:120px"></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="STT">@(_danhSach.IndexOf(context)+1)</MudTd>
            <MudTd DataLabel="Mã đơn"><b>@context.MaDonHang</b></MudTd>
            <MudTd DataLabel="Loại">@(context.LoaiDonHang == LoaiDonHang.Dish ? "Món ăn" : "Thực phẩm")</MudTd>
            <MudTd DataLabel="Trường">@context.MaTruong</MudTd>
            <MudTd DataLabel="Ngày">@(context.NgayDonHang?.ToString("dd/MM/yyyy") ?? "-")</MudTd>
            <MudTd DataLabel="Trạng thái">
                <MudChip T="string" Size="Size.Small" Color="@MauTrangThai(context.TrangThai)">
                    @TrangThaiDonHang.Nhan(context.TrangThai)
                </MudChip>
            </MudTd>
            <MudTd Style="text-align:center">@context.ChiTiet.Count / @context.XuatKho.Count</MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                               OnClick="@(() => MoForm(context))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                               OnClick="@(() => XacNhanXoaAsync(context))" />
            </MudTd>
        </RowTemplate>
    </MudTable>
}

<MudDialog @bind-Visible="_hienForm" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">@(_dangSua ? "Sửa đơn hàng" : "Thêm đơn hàng")</MudText>
    </TitleContent>
    <DialogContent>
        <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pt-4">
            <MudTabPanel Text="1. Thông tin đơn">
                <MudForm @ref="_form" Model="_input">
                    <MudGrid>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_input.MaDonHang" Label="Mã đơn hàng"
                                          Variant="Variant.Outlined" MaxLength="255"
                                          Required="true" RequiredError="Vui lòng nhập mã đơn hàng" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudSelect T="string" @bind-Value="_input.LoaiDonHang" Label="Loại đơn"
                                       Variant="Variant.Outlined">
                                <MudSelectItem T="string" Value="@LoaiDonHang.Food">Thực phẩm (food)</MudSelectItem>
                                <MudSelectItem T="string" Value="@LoaiDonHang.Dish">Món ăn (dish)</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_input.MaTruong" Label="Mã trường"
                                          Variant="Variant.Outlined" MaxLength="255"
                                          Required="true" RequiredError="Vui lòng nhập mã trường" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudSelect T="string" @bind-Value="_input.TrangThai" Label="Trạng thái"
                                       Variant="Variant.Outlined">
                                @foreach (var (ma, nhan) in TrangThaiDonHang.DanhSach)
                                {
                                    <MudSelectItem T="string" Value="@ma">@nhan</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudDatePicker @bind-Date="_ngayDonHang" Label="Ngày đơn hàng"
                                           Variant="Variant.Outlined" DateFormat="dd/MM/yyyy" Editable="true" Mask="@(new DateMask("dd/MM/yyyy"))" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudSelect T="string" @bind-Value="_input.MaNguoiGiao" Label="Người giao hàng"
                                       Variant="Variant.Outlined" Clearable="true" HelperText="Không bắt buộc.">
                                @foreach (var ns in _nhanSu)
                                {
                                    <MudSelectItem T="string" Value="@ns.MaNhanSu">@ns.MaNhanSu — @ns.HoTen</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="8">
                            <MudTextField @bind-Value="_input.DiaChiNhan" Label="Địa chỉ nhận"
                                          Variant="Variant.Outlined" MaxLength="500" />
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudTextField @bind-Value="_input.DiemGiao" Label="Điểm giao"
                                          Variant="Variant.Outlined" MaxLength="255" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField @bind-Value="_input.GhiChu" Label="Ghi chú"
                                          Variant="Variant.Outlined" MaxLength="2000" />
                        </MudItem>
                    </MudGrid>
                </MudForm>
            </MudTabPanel>

            <MudTabPanel Text="@($"2. Dòng đặt hàng ({_input.ChiTiet.Count})")">
                <div class="d-flex justify-end mb-2">
                    <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.Add"
                               OnClick="ThemDong">Thêm dòng</MudButton>
                </div>
                @foreach (var dong in _input.ChiTiet)
                {
                    <MudPaper Class="pa-3 mb-2" Elevation="1">
                        <MudGrid>
                            <MudItem xs="12" sm="6">
                                @if (_input.LoaiDonHang == LoaiDonHang.Dish)
                                {
                                    <MudSelect T="string" @bind-Value="dong.MaMonAn" Label="Món ăn"
                                               Variant="Variant.Outlined">
                                        @foreach (var m in _monAn)
                                        {
                                            <MudSelectItem T="string" Value="@m.MaMonAn">@m.MaMonAn — @m.TenMonAn</MudSelectItem>
                                        }
                                    </MudSelect>
                                }
                                else if (_danhMucChuan.Count > 0)
                                {
                                    <MudSelect T="string" @bind-Value="dong.MaLoaiSp" Label="Loại thực phẩm"
                                               Variant="Variant.Outlined">
                                        @foreach (var dm in _danhMucChuan)
                                        {
                                            <MudSelectItem T="string" Value="@dm.Code">@dm.Code — @dm.Name</MudSelectItem>
                                        }
                                    </MudSelect>
                                }
                                else
                                {
                                    <MudTextField @bind-Value="dong.MaLoaiSp" Label="Mã loại thực phẩm"
                                                  Variant="Variant.Outlined" MaxLength="100"
                                                  HelperText="vd THIT, RAU_CU" />
                                }
                            </MudItem>
                            <MudItem xs="6" sm="3">
                                <MudNumericField @bind-Value="dong.SoLuong" Label="Số lượng"
                                                 Variant="Variant.Outlined" Min="0m" />
                            </MudItem>
                            <MudItem xs="6" sm="3">
                                <MudTextField @bind-Value="dong.PathFile" Label="Ảnh dòng (nếu có)"
                                              Variant="Variant.Outlined" MaxLength="1000" />
                            </MudItem>
                        </MudGrid>
                        <div class="d-flex justify-end mt-2">
                            <MudButton Size="Size.Small" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete"
                                       OnClick="@(() => _input.ChiTiet.Remove(dong))">Xoá dòng</MudButton>
                        </div>
                    </MudPaper>
                }
            </MudTabPanel>

            <MudTabPanel Text="@($"3. Xuất kho ({_input.XuatKho.Count})")" Disabled="@(_input.LoaiDonHang == LoaiDonHang.Dish)">
                @if (_input.LoaiDonHang == LoaiDonHang.Dish)
                {
                    <MudAlert Severity="Severity.Info">Đơn món ăn không khai xuất kho.</MudAlert>
                }
                else
                {
                    <div class="d-flex justify-end mb-2">
                        <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="ThemXuatKho" Disabled="@(_kho.Count == 0)">Thêm dòng xuất kho</MudButton>
                    </div>
                    @if (_kho.Count == 0)
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true">
                            Cần có Kho, Thực phẩm và Lô sản xuất để khai xuất kho.
                        </MudAlert>
                    }
                    @foreach (var xk in _input.XuatKho)
                    {
                        <MudPaper Class="pa-3 mb-2" Elevation="1">
                            <MudGrid>
                                <MudItem xs="12" sm="4">
                                    <MudSelect T="string" @bind-Value="xk.MaSanPham" Label="Thực phẩm"
                                               Variant="Variant.Outlined">
                                        @foreach (var sp in _sanPham)
                                        {
                                            <MudSelectItem T="string" Value="@sp.MaSanPham">@sp.MaSanPham — @sp.TenSanPham</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudItem>
                                <MudItem xs="6" sm="4">
                                    <MudSelect T="string" @bind-Value="xk.MaKho" Label="Kho xuất"
                                               Variant="Variant.Outlined">
                                        @foreach (var k in _kho)
                                        {
                                            <MudSelectItem T="string" Value="@k.MaKho">@k.MaKho — @k.TenKho</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudItem>
                                <MudItem xs="6" sm="4">
                                    <MudSelect T="string" @bind-Value="xk.MaLo" Label="Lô xuất"
                                               Variant="Variant.Outlined">
                                        @foreach (var lo in _lo)
                                        {
                                            <MudSelectItem T="string" Value="@lo.MaLo">@lo.MaLo — @lo.TenLo</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudItem>
                                <MudItem xs="6" sm="4">
                                    <MudNumericField @bind-Value="xk.SoLuong" Label="Số lượng xuất"
                                                     Variant="Variant.Outlined" Min="0m" />
                                </MudItem>
                                <MudItem xs="6" sm="4">
                                    <MudTextField @bind-Value="xk.MaXuatKho" Label="Mã phiếu xuất (nếu có)"
                                                  Variant="Variant.Outlined" MaxLength="255" />
                                </MudItem>
                                <MudItem xs="12" sm="4">
                                    <MudTextField @bind-Value="xk.MaLoaiSp" Label="Mã loại TP (nếu có)"
                                                  Variant="Variant.Outlined" MaxLength="100" />
                                </MudItem>
                            </MudGrid>
                            <div class="d-flex justify-end mt-2">
                                <MudButton Size="Size.Small" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete"
                                           OnClick="@(() => _input.XuatKho.Remove(xk))">Xoá</MudButton>
                            </div>
                        </MudPaper>
                    }
                }
            </MudTabPanel>

            <MudTabPanel Text="@($"4. Ảnh ({_input.Images.Count})")">
                <div class="d-flex justify-space-between align-center mb-2">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Tối đa 3 ảnh, thứ tự 1–3.</MudText>
                    <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.Add"
                               OnClick="ThemAnh" Disabled="@(_input.Images.Count >= 3)">Thêm ảnh</MudButton>
                </div>
                @foreach (var anh in _input.Images)
                {
                    <MudPaper Class="pa-3 mb-2" Elevation="1">
                        <MudGrid>
                            <MudItem xs="9">
                                <MudTextField @bind-Value="anh.PathFile" Label="Đường dẫn ảnh"
                                              Variant="Variant.Outlined" MaxLength="1000" />
                            </MudItem>
                            <MudItem xs="3">
                                <MudNumericField @bind-Value="anh.SortOrder" Label="Thứ tự"
                                                 Variant="Variant.Outlined" Min="1" Max="3" />
                            </MudItem>
                        </MudGrid>
                        <div class="d-flex justify-end mt-2">
                            <MudButton Size="Size.Small" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete"
                                       OnClick="@(() => _input.Images.Remove(anh))">Xoá ảnh</MudButton>
                        </div>
                    </MudPaper>
                }
            </MudTabPanel>
        </MudTabs>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _hienForm = false)">Huỷ</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   Disabled="_dangLuu" OnClick="LuuAsync">Lưu</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<Order> _danhSach = new();
    private List<Dish> _monAn = new();
    private List<Product> _sanPham = new();
    private List<Warehouse> _kho = new();
    private List<Batch> _lo = new();
    private List<Staff> _nhanSu = new();
    private List<StandardFoodCategory> _danhMucChuan = new();

    private bool _dangTai = true;
    private bool _dangLuu;

    private bool _hienForm;
    private bool _dangSua;
    private MudForm? _form;
    private Order _input = new();
    private DateTime? _ngayDonHang;

    private readonly DialogOptions _dialogOptions =
        new() { MaxWidth = MaxWidth.Large, FullWidth = true, CloseOnEscapeKey = false };

    protected override async Task OnInitializedAsync() => await TaiDanhSachAsync();

    private async Task TaiDanhSachAsync()
    {
        _dangTai = true;
        _danhSach = (await DonHangService.LayTatCaAsync()).ToList();
        _monAn = (await MonAnService.LayTatCaAsync()).ToList();
        _sanPham = (await ThucPhamService.LayTatCaAsync()).ToList();
        _kho = (await KhoService.LayTatCaAsync()).ToList();
        _lo = (await LoService.LayTatCaAsync()).ToList();
        _nhanSu = (await NhanSuService.LayTatCaAsync()).ToList();
        _danhMucChuan = (await DanhMucChuanService.LayTatCaAsync()).ToList();
        _dangTai = false;
    }

    private static Color MauTrangThai(string ma) => ma switch
    {
        "GIAO_HANG_THANH_CONG" or "DA_GIAO" => Color.Success,
        "DANG_GIAO" or "DANG_CHUAN_BI" or "CHO_XAC_NHAN" => Color.Info,
        "TU_CHOI" or "HUY" or "TRA_HANG" => Color.Error,
        _ => Color.Default
    };

    private void ThemDong() => _input.ChiTiet.Add(new OrderLine());
    private void ThemXuatKho() => _input.XuatKho.Add(new OrderExport());
    private void ThemAnh()
    {
        var thuTu = Enumerable.Range(1, 3).FirstOrDefault(n => _input.Images.All(i => i.SortOrder != n));
        _input.Images.Add(new OrderImage { SortOrder = thuTu == 0 ? 1 : thuTu });
    }

    private void MoForm(Order? dh)
    {
        _dangSua = dh is not null;

        if (dh is null)
        {
            _input = new Order();
            _ngayDonHang = DateTime.Today;
        }
        else
        {
            _input = new Order
            {
                Id = dh.Id,
                MaDonHang = dh.MaDonHang,
                LoaiDonHang = dh.LoaiDonHang,
                MaTruong = dh.MaTruong,
                DiaChiNhan = dh.DiaChiNhan,
                DiemGiao = dh.DiemGiao,
                MaNguoiGiao = dh.MaNguoiGiao,
                TrangThai = dh.TrangThai,
                NgayDonHang = dh.NgayDonHang,
                GhiChu = dh.GhiChu,
                Images = dh.Images.Select(i => new OrderImage { PathFile = i.PathFile, SortOrder = i.SortOrder }).ToList(),
                ChiTiet = dh.ChiTiet.Select(l => new OrderLine
                {
                    MaLoaiSp = l.MaLoaiSp, MaMonAn = l.MaMonAn, SoLuong = l.SoLuong, PathFile = l.PathFile
                }).ToList(),
                XuatKho = dh.XuatKho.Select(x => new OrderExport
                {
                    MaXuatKho = x.MaXuatKho, MaLoaiSp = x.MaLoaiSp, MaSanPham = x.MaSanPham,
                    MaKho = x.MaKho, MaLo = x.MaLo, SoLuong = x.SoLuong
                }).ToList()
            };
            _ngayDonHang = dh.NgayDonHang?.ToDateTime(TimeOnly.MinValue);
        }

        _hienForm = true;
    }

    private async Task LuuAsync()
    {
        if (_form is not null)
        {
            await _form.Validate();
            if (!_form.IsValid) return;
        }

        _input.NgayDonHang = _ngayDonHang is { } d ? DateOnly.FromDateTime(d) : null;

        _dangLuu = true;
        var ketQua = _dangSua
            ? await DonHangService.CapNhatAsync(_input)
            : await DonHangService.ThemAsync(_input);
        _dangLuu = false;

        Snackbar.Add(ketQua.ThongBao, ketQua.ThanhCong ? Severity.Success : Severity.Error);

        if (ketQua.ThanhCong)
        {
            _hienForm = false;
            await TaiDanhSachAsync();
        }
    }

    private async Task XacNhanXoaAsync(Order dh)
    {
        var dongY = await DialogService.ShowMessageBox(
            "Xác nhận xoá",
            $"Xoá đơn hàng \"{dh.MaDonHang}\"?",
            yesText: "Xoá", cancelText: "Huỷ");

        if (dongY != true) return;

        var ketQua = await DonHangService.XoaAsync(dh.Id);
        Snackbar.Add(ketQua.ThongBao, ketQua.ThanhCong ? Severity.Success : Severity.Error);

        if (ketQua.ThanhCong) await TaiDanhSachAsync();
    }
}
