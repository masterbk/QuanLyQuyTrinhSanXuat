@page "/app/xuat-ban"
@using HCP.Domain.Constants
@using HCP.Domain.Entities.Business
@using HCP.Domain.Enums
@using HCP.Infrastructure.Services.DanhMuc
@using HCP.Infrastructure.Services.Kho
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = AppRoles.TenantAdmin + "," + AppRoles.TenantStaff)]
@inject IPhieuXuatBanService XuatBanService
@inject IKhachHangService KhachHangService
@inject IDanhMucService<Product> ThucPhamService
@inject IDanhMucService<Warehouse> KhoDanhMucService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Xuất bán</PageTitle>

<div class="d-flex justify-space-between align-center mb-4">
    <div>
        <MudText Typo="Typo.h5">Phiếu xuất bán</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            Bán thành phẩm cho khách hàng - khi thực hiện sẽ trừ tồn thành phẩm theo lô (lô hết hạn trước xuất trước).
        </MudText>
    </div>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
               OnClick="MoForm" Disabled="@(_khachHang.Count == 0 || _thanhPham.Count == 0 || _kho.Count == 0)">
        Tạo phiếu
    </MudButton>
</div>

@if (_dangTai)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    @if (_khachHang.Count == 0)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4" Dense="true">
            Chưa có khách hàng. Thêm ở <MudLink Href="/app/khach-hang">Khách hàng</MudLink> trước.
        </MudAlert>
    }
    @if (_thanhPham.Count == 0)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4" Dense="true">
            Chưa có thành phẩm nào. Khai ở <MudLink Href="/app/thuc-pham">Thực phẩm / SKU</MudLink> (loại "Thành phẩm").
        </MudAlert>
    }

    @if (_danhSach.Count == 0)
    {
        <MudAlert Severity="Severity.Info">Chưa có phiếu xuất bán nào.</MudAlert>
    }
    else
    {
        <MudTable Items="_danhSach" Hover="true" Dense="true" Elevation="1">
            <HeaderContent>
                <MudTh>Mã phiếu</MudTh>
                <MudTh>Khách hàng</MudTh>
                <MudTh>Kho</MudTh>
                <MudTh Style="text-align:right">Số dòng</MudTh>
                <MudTh>Ngày xuất</MudTh>
                <MudTh>Trạng thái</MudTh>
                <MudTh Style="width:170px"></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Mã phiếu"><b>@context.MaPhieu</b></MudTd>
                <MudTd DataLabel="Khách hàng">@TenKhach(context.MaKhachHang)</MudTd>
                <MudTd DataLabel="Kho">@context.MaKho</MudTd>
                <MudTd DataLabel="Số dòng" Style="text-align:right">@context.ChiTiet.Count</MudTd>
                <MudTd DataLabel="Ngày xuất">@context.NgayXuat.ToString("dd/MM/yyyy")</MudTd>
                <MudTd DataLabel="Trạng thái">
                    @if (context.TrangThai == TrangThaiXuatBan.HoanThanh)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Success">Đã xuất</MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Info">Mới tạo</MudChip>
                    }
                </MudTd>
                <MudTd>
                    @if (context.TrangThai == TrangThaiXuatBan.MoiTao)
                    {
                        <MudButton Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                                   StartIcon="@Icons.Material.Filled.PlayArrow" Disabled="_dangXuLy"
                                   OnClick="@(() => ThucHienAsync(context))">Thực hiện</MudButton>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                       OnClick="@(() => XoaAsync(context))" />
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            @context.ThoiGianHoanThanhUtc?.ToLocalTime().ToString("dd/MM HH:mm")
                        </MudText>
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
}

<MudDialog @bind-Visible="_hienForm" Options="_dialogOptions">
    <TitleContent><MudText Typo="Typo.h6">Tạo phiếu xuất bán</MudText></TitleContent>
    <DialogContent>
        <MudForm @ref="_form" Model="_input">
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_input.MaPhieu" Label="Mã phiếu" Variant="Variant.Outlined"
                                  MaxLength="255" Required="true" RequiredError="Nhập mã phiếu"
                                  HelperText="vd XB-001." />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="string" @bind-Value="_input.MaKhachHang" Label="Khách hàng"
                               Variant="Variant.Outlined" Required="true" RequiredError="Chọn khách hàng">
                        @foreach (var kh in _khachHang)
                        {
                            <MudSelectItem T="string" Value="@kh.MaKhachHang">@kh.TenKhachHang (@kh.MaKhachHang)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="6" sm="6">
                    <MudSelect T="string" @bind-Value="_input.MaKho" Label="Kho" Variant="Variant.Outlined"
                               Required="true" RequiredError="Chọn kho">
                        @foreach (var k in _kho)
                        {
                            <MudSelectItem T="string" Value="@k.MaKho">@k.TenKho (@k.MaKho)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="6" sm="6">
                    <MudDatePicker @bind-Date="_ngayXuat" Label="Ngày xuất"
                                   Variant="Variant.Outlined" DateFormat="dd/MM/yyyy" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_input.GhiChu" Label="Ghi chú" Variant="Variant.Outlined" MaxLength="1000" />
                </MudItem>
            </MudGrid>
        </MudForm>

        <div class="d-flex justify-space-between align-center mt-3 mb-1">
            <MudText Typo="Typo.subtitle2">Thành phẩm bán</MudText>
            <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add"
                       OnClick="ThemDong">Thêm dòng</MudButton>
        </div>
        <MudTable Items="_dong" Dense="true" Elevation="0">
            <HeaderContent>
                <MudTh>Thành phẩm</MudTh>
                <MudTh Style="width:130px;text-align:right">Số lượng</MudTh>
                <MudTh Style="width:40px"></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>
                    <MudSelect T="string" @bind-Value="context.MaThanhPham" Variant="Variant.Outlined"
                               Dense="true" Margin="Margin.Dense">
                        @foreach (var tp in _thanhPham)
                        {
                            <MudSelectItem T="string" Value="@tp.MaSanPham">@tp.TenSanPham (@tp.MaSanPham)</MudSelectItem>
                        }
                    </MudSelect>
                </MudTd>
                <MudTd Style="text-align:right">
                    <MudNumericField @bind-Value="context.SoLuong" Variant="Variant.Outlined"
                                     Min="0m" Margin="Margin.Dense" />
                </MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Error"
                                   OnClick="@(() => XoaDong(context))" />
                </MudTd>
            </RowTemplate>
        </MudTable>

        <div class="d-flex justify-end mt-2">
            <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Calculate"
                       OnClick="KiemTraTonAsync">Kiểm tra tồn</MudButton>
        </div>
        @if (_preview.Count > 0)
        {
            <MudTable Items="_preview" Dense="true" Elevation="0" Class="mt-2">
                <HeaderContent>
                    <MudTh>Thành phẩm</MudTh>
                    <MudTh Style="text-align:right">Cần</MudTh>
                    <MudTh Style="text-align:right">Tồn</MudTh>
                    <MudTh>Đủ?</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.TenThanhPham</MudTd>
                    <MudTd Style="text-align:right">@context.Can.ToString("0.###") @context.DonViTinh</MudTd>
                    <MudTd Style="text-align:right">@context.Ton.ToString("0.###")</MudTd>
                    <MudTd>
                        @if (context.Du)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Success">Đủ</MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Error">Thiếu</MudChip>
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _hienForm = false)">Huỷ</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="_dangLuu" OnClick="LuuAsync">
            Tạo phiếu
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<PhieuXuatBan> _danhSach = new();
    private List<KhachHang> _khachHang = new();
    private List<Product> _thanhPham = new();
    private List<Warehouse> _kho = new();
    private List<PhieuXuatBanChiTiet> _dong = new();
    private List<TonThanhPhamDto> _preview = new();

    private bool _dangTai = true;
    private bool _dangLuu;
    private bool _dangXuLy;

    private MudForm? _form;
    private bool _hienForm;
    private PhieuXuatBan _input = new();
    private DateTime? _ngayXuat;

    private readonly DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Medium, FullWidth = true };

    protected override async Task OnInitializedAsync() => await TaiAsync();

    private async Task TaiAsync()
    {
        _dangTai = true;
        _danhSach = (await XuatBanService.LayTatCaAsync()).ToList();
        _khachHang = (await KhachHangService.LayTatCaAsync()).ToList();
        _kho = (await KhoDanhMucService.LayTatCaAsync()).ToList();
        _thanhPham = (await ThucPhamService.LayTatCaAsync())
            .Where(p => p.LoaiSanPham == LoaiSanPham.ThanhPham).ToList();
        _dangTai = false;
    }

    private string TenKhach(string ma) =>
        _khachHang.FirstOrDefault(k => k.MaKhachHang == ma)?.TenKhachHang ?? ma;

    private void MoForm()
    {
        _input = new PhieuXuatBan();
        _ngayXuat = DateTime.Today;
        _dong = new List<PhieuXuatBanChiTiet> { new() { SoLuong = 1 } };
        _preview = new List<TonThanhPhamDto>();
        _hienForm = true;
    }

    private void ThemDong() => _dong.Add(new PhieuXuatBanChiTiet { SoLuong = 1 });

    private void XoaDong(PhieuXuatBanChiTiet d)
    {
        _dong.Remove(d);
        if (_dong.Count == 0) _dong.Add(new PhieuXuatBanChiTiet { SoLuong = 1 });
    }

    private async Task KiemTraTonAsync()
    {
        if (string.IsNullOrWhiteSpace(_input.MaKho))
        {
            Snackbar.Add("Chọn kho trước.", Severity.Info);
            return;
        }
        _preview = (await XuatBanService.KiemTraTonAsync(_dong, _input.MaKho)).ToList();
        if (_preview.Count == 0) Snackbar.Add("Chưa có dòng thành phẩm hợp lệ để kiểm tra.", Severity.Info);
    }

    private async Task LuuAsync()
    {
        if (_form is not null)
        {
            await _form.Validate();
            if (!_form.IsValid) return;
        }
        _input.NgayXuat = _ngayXuat is { } d ? DateOnly.FromDateTime(d) : DateOnly.FromDateTime(DateTime.Today);
        _input.ChiTiet = _dong;

        _dangLuu = true;
        var kq = await XuatBanService.TaoAsync(_input);
        _dangLuu = false;
        Snackbar.Add(kq.ThongBao, kq.ThanhCong ? Severity.Success : Severity.Error);
        if (kq.ThanhCong) { _hienForm = false; await TaiAsync(); }
    }

    private async Task ThucHienAsync(PhieuXuatBan phieu)
    {
        var dongY = await DialogService.ShowMessageBox("Xác nhận thực hiện",
            $"Thực hiện phiếu \"{phieu.MaPhieu}\"? Hệ thống sẽ trừ tồn thành phẩm khỏi kho.",
            yesText: "Thực hiện", cancelText: "Huỷ");
        if (dongY != true) return;

        _dangXuLy = true;
        var kq = await XuatBanService.ThucHienAsync(phieu.Id);
        _dangXuLy = false;
        Snackbar.Add(kq.ThongBao, kq.ThanhCong ? Severity.Success : Severity.Error);
        if (kq.ThanhCong) await TaiAsync();
    }

    private async Task XoaAsync(PhieuXuatBan phieu)
    {
        var dongY = await DialogService.ShowMessageBox("Xác nhận xoá",
            $"Xoá phiếu \"{phieu.MaPhieu}\"?", yesText: "Xoá", cancelText: "Huỷ");
        if (dongY != true) return;

        var kq = await XuatBanService.XoaAsync(phieu.Id);
        Snackbar.Add(kq.ThongBao, kq.ThanhCong ? Severity.Success : Severity.Error);
        if (kq.ThanhCong) await TaiAsync();
    }
}
