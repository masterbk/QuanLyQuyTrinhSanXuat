@page "/app/lenh-san-xuat"
@using HCP.Domain.Constants
@using HCP.Domain.Entities.Business
@using HCP.Domain.Enums
@using HCP.Infrastructure.Services.DanhMuc
@using HCP.Infrastructure.Services.Kho
@using HCP.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@attribute [Authorize(Roles = AppRoles.TenantAdmin + "," + AppRoles.TenantStaff)]
@inject ILenhSanXuatService LenhService
@inject IDinhMucService DinhMucService
@inject IDanhMucService<Product> ThucPhamService
@inject IDanhMucService<Warehouse> KhoDanhMucService
@inject ILuuTruAnhService LuuTruAnh
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Lệnh sản xuất</PageTitle>

<div class="d-flex justify-space-between align-center mb-4">
    <div>
        <MudText Typo="Typo.h5">Lệnh sản xuất</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            Sản xuất thành phẩm theo định mức - tự trừ nguyên liệu (lô hết hạn trước xuất trước) và
            nhập thành phẩm vào kho.
        </MudText>
    </div>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
               OnClick="MoForm" Disabled="@(_thanhPham.Count == 0 || _kho.Count == 0)">
        Tạo lệnh
    </MudButton>
</div>

@if (_dangTai)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    @if (_thanhPham.Count == 0)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4">
            Chưa có thành phẩm nào có định mức. Khai <MudLink Href="/app/dinh-muc">Định mức</MudLink> trước.
        </MudAlert>
    }

    @if (_danhSach.Count == 0)
    {
        <MudAlert Severity="Severity.Info">Chưa có lệnh sản xuất nào.</MudAlert>
    }
    else
    {
        <MudTable Items="_danhSach" Hover="true" Dense="true" Elevation="1">
            <HeaderContent>
                <MudTh Style="width:56px">STT</MudTh>
                <MudTh>Mã lệnh</MudTh>
                <MudTh>Thành phẩm</MudTh>
                <MudTh Style="text-align:right">Số lượng</MudTh>
                <MudTh>Kho</MudTh>
                <MudTh>Lô TP</MudTh>
                <MudTh>Ngày SX</MudTh>
                <MudTh>Trạng thái</MudTh>
                <MudTh Style="width:170px"></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="STT">@(_danhSach.IndexOf(context)+1)</MudTd>
                <MudTd DataLabel="Mã lệnh"><b>@context.MaLenh</b></MudTd>
                <MudTd DataLabel="Thành phẩm">@context.MaThanhPham</MudTd>
                <MudTd DataLabel="Số lượng" Style="text-align:right">@context.SoLuong.ToString("0.###")</MudTd>
                <MudTd DataLabel="Kho">@context.MaKho</MudTd>
                <MudTd DataLabel="Lô TP">@context.MaLoThanhPham</MudTd>
                <MudTd DataLabel="Ngày SX">@context.NgaySanXuat.ToString("dd/MM/yyyy")</MudTd>
                <MudTd DataLabel="Trạng thái">
                    @if (context.TrangThai == TrangThaiLenhSX.HoanThanh)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Success">Hoàn thành</MudChip>
                    }
                    else if (context.TrangThai == TrangThaiLenhSX.DaHuy)
                    {
                        <MudTooltip Text="@($"Lý do: {context.LyDoHuy}")">
                            <MudChip T="string" Size="Size.Small" Color="Color.Default">Đã huỷ</MudChip>
                        </MudTooltip>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Info">Mới tạo</MudChip>
                    }
                </MudTd>
                <MudTd>
                    @if (context.TrangThai == TrangThaiLenhSX.MoiTao)
                    {
                        <MudButton Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                                   StartIcon="@Icons.Material.Filled.CheckCircle" Disabled="_dangXuLy"
                                   OnClick="@(() => MoHoanThanh(context))">Hoàn thành</MudButton>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                       OnClick="@(() => XoaAsync(context))" />
                    }
                    else if (context.TrangThai == TrangThaiLenhSX.HoanThanh)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            @context.ThoiGianHoanThanhUtc?.ToLocalTime().ToString("dd/MM HH:mm")
                        </MudText>
                        @if (!string.IsNullOrEmpty(context.MaLoDaTao))
                        {
                            <MudTooltip Text="Đã tạo lô đồng bộ HanoiCheck">
                                <MudChip T="string" Size="Size.Small" Color="Color.Secondary"
                                         Icon="@Icons.Material.Filled.CloudSync">@context.MaLoDaTao</MudChip>
                            </MudTooltip>
                        }
                        <MudTooltip Text="Huỷ lệnh: trả lại nguyên liệu, thu hồi thành phẩm">
                            <MudIconButton Icon="@Icons.Material.Filled.Undo" Size="Size.Small" Color="Color.Error"
                                           Disabled="_dangXuLy" OnClick="@(() => MoHuy(context))" />
                        </MudTooltip>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            Huỷ @context.ThoiGianHuyUtc?.ToLocalTime().ToString("dd/MM HH:mm")
                        </MudText>
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
}

<MudDialog @bind-Visible="_hienHoanThanh" Options="_dialogHuyOptions">
    <TitleContent><MudText Typo="Typo.h6">Hoàn thành lệnh sản xuất</MudText></TitleContent>
    <DialogContent>
        @if (_lenhHoanThanh is not null)
        {
            <MudText Typo="Typo.body2" Class="mb-3">
                Hoàn thành lệnh <b>@_lenhHoanThanh.MaLenh</b>? Hệ thống sẽ trừ nguyên liệu theo định mức
                và nhập @_lenhHoanThanh.SoLuong.ToString("0.###") thành phẩm vào lô
                <b>@_lenhHoanThanh.MaLoThanhPham</b>.
            </MudText>

            <MudText Typo="Typo.subtitle2">Ảnh lô sản phẩm <span class="mud-error-text">*</span></MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                Bắt buộc ít nhất 1 ảnh. Ảnh này chính là mục "File" của Lô sản xuất khi đồng bộ HanoiCheck.
            </MudText>

            <div class="mt-2 mb-2">
                <MudFileUpload T="IReadOnlyList<IBrowserFile>" FilesChanged="ChonAnhAsync"
                               Accept="image/*" MaximumFileCount="10">
                    <ActivatorContent>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="_dangTaiAnh"
                                   StartIcon="@Icons.Material.Filled.PhotoCamera">Chọn ảnh</MudButton>
                    </ActivatorContent>
                </MudFileUpload>
                @if (_dangTaiAnh)
                {
                    <MudProgressLinear Indeterminate="true" Class="mt-2" />
                }
            </div>

            @if (_anhDaChon.Count == 0)
            {
                <MudAlert Severity="Severity.Warning" Dense="true">Chưa có ảnh nào.</MudAlert>
            }
            else
            {
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var anh in _anhDaChon)
                    {
                        <MudPaper Class="pa-1" Elevation="1" Style="width:110px">
                            <MudImage Src="@anh.DuongDan" Alt="@anh.TenFile" Height="80" Width="100"
                                      ObjectFit="ObjectFit.Cover" Class="rounded" />
                            <MudTooltip Text="@anh.TenFile">
                                <MudText Typo="Typo.caption" Class="d-block text-truncate" Style="max-width:100px">
                                    @anh.TenFile
                                </MudText>
                            </MudTooltip>
                            <MudButton Size="Size.Small" Color="Color.Error" FullWidth="true"
                                       OnClick="@(() => _anhDaChon.Remove(anh))">Bỏ</MudButton>
                        </MudPaper>
                    }
                </div>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _hienHoanThanh = false)">Huỷ</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="HoanThanhAsync"
                   Disabled="@(_dangXuLy || _dangTaiAnh || _anhDaChon.Count == 0)">
            Hoàn thành
        </MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_hienHuy" Options="_dialogHuyOptions">
    <TitleContent><MudText Typo="Typo.h6">Huỷ lệnh sản xuất</MudText></TitleContent>
    <DialogContent>
        @if (_lenhHuy is not null)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
                Huỷ lệnh <b>@_lenhHuy.MaLenh</b>: hệ thống ghi bút toán đảo - trả lại nguyên liệu về
                đúng lô đã trừ và thu hồi @_lenhHuy.SoLuong.ToString("0.###") thành phẩm ở lô
                <b>@_lenhHuy.MaLoThanhPham</b>. Lệnh vẫn được giữ lại để truy xuất.
            </MudAlert>
            @if (!string.IsNullOrEmpty(_lenhHuy.MaLoDaTao))
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">
                    Lệnh này đã sinh lô <b>@_lenhHuy.MaLoDaTao</b> để đồng bộ HanoiCheck. Lô sẽ bị xoá
                    trong app, nhưng nếu đã gửi đi thì HanoiCheck KHÔNG tự thu hồi - phải xử lý thủ công bên đó.
                </MudAlert>
            }
            <MudTextField @bind-Value="_lyDoHuy" Label="Lý do huỷ" Variant="Variant.Outlined"
                          MaxLength="500" Lines="2" Immediate="true"
                          HelperText="Bắt buộc - vd: nhập nhầm số lượng, hỏng mẻ bánh." />
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _hienHuy = false)">Đóng</MudButton>
        <MudButton Color="Color.Error" Variant="Variant.Filled" Disabled="_dangXuLy" OnClick="HuyAsync">
            Huỷ lệnh
        </MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_hienForm" Options="_dialogOptions">
    <TitleContent><MudText Typo="Typo.h6">Tạo lệnh sản xuất</MudText></TitleContent>
    <DialogContent>
        <MudForm @ref="_form" Model="_input">
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_input.MaLenh" Label="Mã lệnh" Variant="Variant.Outlined"
                                  MaxLength="255" Required="true" RequiredError="Nhập mã lệnh"
                                  HelperText="vd LSX-001." />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="string" @bind-Value="_input.MaThanhPham" Label="Thành phẩm"
                               Variant="Variant.Outlined" Required="true" RequiredError="Chọn thành phẩm">
                        @foreach (var tp in _thanhPham)
                        {
                            <MudSelectItem T="string" Value="@tp.MaSanPham">@tp.TenSanPham (@tp.MaSanPham)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="6" sm="4">
                    <MudNumericField @bind-Value="_input.SoLuong" Label="Số lượng" Variant="Variant.Outlined" Min="0m" />
                </MudItem>
                <MudItem xs="6" sm="4">
                    <MudSelect T="string" @bind-Value="_input.MaKho" Label="Kho" Variant="Variant.Outlined"
                               Required="true" RequiredError="Chọn kho">
                        @foreach (var k in _kho)
                        {
                            <MudSelectItem T="string" Value="@k.MaKho">@k.TenKho (@k.MaKho)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudDatePicker @bind-Date="_ngaySanXuat" Label="Ngày sản xuất"
                                   Variant="Variant.Outlined" DateFormat="dd/MM/yyyy" Editable="true" Mask="@(new DateMask("dd/MM/yyyy"))" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_input.MaLoThanhPham" Label="Mã lô thành phẩm"
                                  Variant="Variant.Outlined" MaxLength="255"
                                  Required="true" RequiredError="Nhập mã lô thành phẩm" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudDatePicker @bind-Date="_hsdThanhPham" Label="Hạn dùng thành phẩm"
                                   Variant="Variant.Outlined" DateFormat="dd/MM/yyyy" Editable="true" Mask="@(new DateMask("dd/MM/yyyy"))" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_input.GhiChu" Label="Ghi chú" Variant="Variant.Outlined" MaxLength="1000" />
                </MudItem>
                <MudItem xs="12">
                    <MudCheckBox @bind-Value="_input.TaoLoDongBo" Color="Color.Primary" Dense="true"
                                 Label="Khi hoàn thành, tạo Lô sản xuất và đồng bộ HanoiCheck (truy xuất lô nguyên liệu → lô thành phẩm)" />
                </MudItem>
            </MudGrid>
        </MudForm>

        <div class="d-flex justify-space-between align-center mt-3 mb-1">
            <MudText Typo="Typo.subtitle2">Nguyên liệu cần</MudText>
            <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Calculate"
                       OnClick="TinhNguyenLieuAsync">Tính nguyên liệu</MudButton>
        </div>
        @if (_preview.Count > 0)
        {
            <MudTable Items="_preview" Dense="true" Elevation="0">
                <HeaderContent>
                    <MudTh>Nguyên liệu</MudTh>
                    <MudTh Style="text-align:right">Cần</MudTh>
                    <MudTh Style="text-align:right">Tồn</MudTh>
                    <MudTh>Đủ?</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.TenNguyenLieu</MudTd>
                    <MudTd Style="text-align:right">@context.Can.ToString("0.###") @context.DonViTinh</MudTd>
                    <MudTd Style="text-align:right">@context.Ton.ToString("0.###")</MudTd>
                    <MudTd>
                        @if (context.Du)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Success">Đủ</MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Error">Thiếu</MudChip>
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _hienForm = false)">Huỷ</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="_dangLuu" OnClick="LuuAsync">
            Tạo lệnh
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<LenhSanXuat> _danhSach = new();
    private List<Product> _thanhPham = new();   // chỉ thành phẩm CÓ định mức
    private List<Warehouse> _kho = new();
    private List<NguyenLieuCanDto> _preview = new();

    private bool _dangTai = true;
    private bool _dangLuu;
    private bool _dangXuLy;

    private MudForm? _form;
    private bool _hienForm;
    private LenhSanXuat _input = new();
    private DateTime? _ngaySanXuat;
    private DateTime? _hsdThanhPham;

    private bool _hienHuy;
    private LenhSanXuat? _lenhHuy;
    private string? _lyDoHuy;

    private bool _hienHoanThanh;
    private bool _dangTaiAnh;
    private LenhSanXuat? _lenhHoanThanh;
    private readonly List<AnhLoSanXuat> _anhDaChon = new();

    private readonly DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Medium, FullWidth = true };
    private readonly DialogOptions _dialogHuyOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true };

    protected override async Task OnInitializedAsync() => await TaiAsync();

    private async Task TaiAsync()
    {
        _dangTai = true;
        _danhSach = (await LenhService.LayTatCaAsync()).ToList();
        _kho = (await KhoDanhMucService.LayTatCaAsync()).ToList();

        var tp = (await ThucPhamService.LayTatCaAsync())
            .Where(p => p.LoaiSanPham == LoaiSanPham.ThanhPham).ToList();
        _thanhPham = new List<Product>();
        foreach (var p in tp)
        {
            var dm = await DinhMucService.LayTheoThanhPhamAsync(p.Id);
            if (dm.Count > 0) _thanhPham.Add(p);   // chỉ hiện thành phẩm đã có định mức
        }
        _dangTai = false;
    }

    private void MoForm()
    {
        _input = new LenhSanXuat { SoLuong = 1 };
        _ngaySanXuat = DateTime.Today;
        _hsdThanhPham = null;
        _preview = new List<NguyenLieuCanDto>();
        _hienForm = true;
    }

    private async Task TinhNguyenLieuAsync()
    {
        if (string.IsNullOrWhiteSpace(_input.MaThanhPham) || string.IsNullOrWhiteSpace(_input.MaKho)
            || _input.SoLuong <= 0)
        {
            Snackbar.Add("Chọn thành phẩm, kho và số lượng trước.", Severity.Info);
            return;
        }
        _preview = (await LenhService.TinhNguyenLieuCanAsync(_input.MaThanhPham, _input.SoLuong, _input.MaKho)).ToList();
    }

    private async Task LuuAsync()
    {
        if (_form is not null)
        {
            await _form.Validate();
            if (!_form.IsValid) return;
        }
        _input.NgaySanXuat = _ngaySanXuat is { } d ? DateOnly.FromDateTime(d) : DateOnly.FromDateTime(DateTime.Today);
        _input.HanSuDungThanhPham = _hsdThanhPham is { } h ? DateOnly.FromDateTime(h) : null;

        _dangLuu = true;
        var kq = await LenhService.TaoAsync(_input);
        _dangLuu = false;
        Snackbar.Add(kq.ThongBao, kq.ThanhCong ? Severity.Success : Severity.Error);
        if (kq.ThanhCong) { _hienForm = false; await TaiAsync(); }
    }

    private void MoHoanThanh(LenhSanXuat lenh)
    {
        _lenhHoanThanh = lenh;
        _anhDaChon.Clear();
        _hienHoanThanh = true;
    }

    /// <summary>Tải ảnh lên đĩa ngay khi chọn để xem trước được; lưu vào DB lúc bấm Hoàn thành.</summary>
    private async Task ChonAnhAsync(IReadOnlyList<IBrowserFile> files)
    {
        _dangTaiAnh = true;
        foreach (var f in files)
        {
            try
            {
                _anhDaChon.Add(await LuuTruAnh.LuuAsync(f));
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
        _dangTaiAnh = false;
    }

    private async Task HoanThanhAsync()
    {
        if (_lenhHoanThanh is null) return;
        if (_anhDaChon.Count == 0)
        {
            Snackbar.Add("Cần tải lên ít nhất 1 ảnh lô sản phẩm.", Severity.Info);
            return;
        }

        _dangXuLy = true;
        var kq = await LenhService.ThucHienAsync(_lenhHoanThanh.Id, _anhDaChon.ToList());
        _dangXuLy = false;
        Snackbar.Add(kq.ThongBao, kq.ThanhCong ? Severity.Success : Severity.Error);
        if (kq.ThanhCong) { _hienHoanThanh = false; await TaiAsync(); }
    }

    private void MoHuy(LenhSanXuat lenh)
    {
        _lenhHuy = lenh;
        _lyDoHuy = null;
        _hienHuy = true;
    }

    private async Task HuyAsync()
    {
        if (_lenhHuy is null) return;
        if (string.IsNullOrWhiteSpace(_lyDoHuy))
        {
            Snackbar.Add("Vui lòng nhập lý do huỷ.", Severity.Info);
            return;
        }

        _dangXuLy = true;
        var kq = await LenhService.HuyAsync(_lenhHuy.Id, _lyDoHuy);
        _dangXuLy = false;
        Snackbar.Add(kq.ThongBao, kq.ThanhCong ? Severity.Success : Severity.Error);
        if (kq.ThanhCong) { _hienHuy = false; await TaiAsync(); }
    }

    private async Task XoaAsync(LenhSanXuat lenh)
    {
        var dongY = await DialogService.ShowMessageBox("Xác nhận xoá",
            $"Xoá lệnh \"{lenh.MaLenh}\"?", yesText: "Xoá", cancelText: "Huỷ");
        if (dongY != true) return;

        var kq = await LenhService.XoaAsync(lenh.Id);
        Snackbar.Add(kq.ThongBao, kq.ThanhCong ? Severity.Success : Severity.Error);
        if (kq.ThanhCong) await TaiAsync();
    }
}
