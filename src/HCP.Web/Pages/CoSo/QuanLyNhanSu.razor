@page "/app/nhan-su"
@using HCP.Domain.Constants
@using HCP.Domain.Entities.Business
@using HCP.Infrastructure.Services.DanhMuc
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = AppRoles.TenantAdmin + "," + AppRoles.TenantStaff)]
@inject IDanhMucService<Staff> NhanSuService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Quản lý nhân sự</PageTitle>

<div class="d-flex justify-space-between align-center mb-4">
    <div>
        <MudText Typo="Typo.h5">Quản lý nhân sự</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            Đồng bộ sang HanoiCheck qua nghiệp vụ "Đồng bộ nhân sự". Số CCCD được mã hoá khi lưu.
        </MudText>
    </div>
    <MudButton Variant="Variant.Filled" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => MoForm(null))">
        Thêm nhân sự
    </MudButton>
</div>

@if (_dangTai)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_danhSach.Count == 0)
{
    <MudAlert Severity="Severity.Info">Chưa có nhân sự nào.</MudAlert>
}
else
{
    <MudTable Items="_danhSach" Hover="true" Elevation="1" Dense="true">
        <HeaderContent>
            <MudTh Style="width:56px">STT</MudTh>
            <MudTh>Mã</MudTh>
            <MudTh>Họ tên</MudTh>
            <MudTh>Vị trí</MudTh>
            <MudTh>Vai trò</MudTh>
            <MudTh>Giấy tờ</MudTh>
            <MudTh>Trạng thái</MudTh>
            <MudTh Style="width:120px"></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="STT">@(_danhSach.IndexOf(context)+1)</MudTd>
            <MudTd DataLabel="Mã"><b>@context.MaNhanSu</b></MudTd>
            <MudTd DataLabel="Họ tên">@context.HoTen</MudTd>
            <MudTd DataLabel="Vị trí">@context.ViTri</MudTd>
            <MudTd DataLabel="Vai trò">
                @if (context.LaChuCoSo)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Class="ma-1">Chủ cơ sở</MudChip>
                }
                @if (context.LaNguoiCheBien)
                {
                    <MudChip T="string" Size="Size.Small" Class="ma-1">Chế biến</MudChip>
                }
                @if (context.LaNguoiGiaoHang)
                {
                    <MudChip T="string" Size="Size.Small" Class="ma-1">Giao hàng</MudChip>
                }
            </MudTd>
            <MudTd DataLabel="Giấy tờ">
                @{
                    var canhBao = CanhBaoKsk(context);
                }
                @if (canhBao is not null)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning"
                             Icon="@Icons.Material.Filled.Warning">@canhBao</MudChip>
                }
                else if (context.CoGiayKhamSucKhoe)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Success">KSK còn hạn</MudChip>
                }
                else
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Chưa khai</MudText>
                }
            </MudTd>
            <MudTd DataLabel="Trạng thái">
                @if (context.TrangThai)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Success">Đang làm</MudChip>
                }
                else
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Default">Nghỉ</MudChip>
                }
            </MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                               OnClick="@(() => MoForm(context))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                               OnClick="@(() => XacNhanXoaAsync(context))" />
            </MudTd>
        </RowTemplate>
    </MudTable>
}

<MudDialog @bind-Visible="_hienForm" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">@(_dangSua ? "Sửa nhân sự" : "Thêm nhân sự")</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" Model="_input">
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_input.MaNhanSu" Label="Mã nhân sự"
                                  Variant="Variant.Outlined" MaxLength="255"
                                  HelperText="Khoá nghiệp vụ, vd NV001."
                                  Required="true" RequiredError="Vui lòng nhập mã nhân sự" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_input.HoTen" Label="Họ tên"
                                  Variant="Variant.Outlined" MaxLength="255"
                                  Required="true" RequiredError="Vui lòng nhập họ tên" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_input.ViTri" Label="Vị trí công việc"
                                  Variant="Variant.Outlined" MaxLength="255" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudDatePicker @bind-Date="_ngaySinh" Label="Ngày sinh"
                                   Variant="Variant.Outlined" DateFormat="dd/MM/yyyy" Editable="true" Mask="@(new DateMask("dd/MM/yyyy"))" />
                </MudItem>
                <MudItem xs="12" sm="8">
                    <MudTextField @bind-Value="_input.DiaChi" Label="Địa chỉ"
                                  Variant="Variant.Outlined" MaxLength="500" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="_input.DienThoai" Label="Số điện thoại"
                                  Variant="Variant.Outlined" MaxLength="20" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_input.Cccd" Label="Số CCCD/CMND"
                                  Variant="Variant.Outlined" MaxLength="20"
                                  Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Lock"
                                  HelperText="Được mã hoá khi lưu vào cơ sở dữ liệu." />
                </MudItem>
                <MudItem xs="12" sm="6" Class="d-flex align-center">
                    <MudSwitch @bind-Value="_input.TrangThai" Color="Color.Success" Label="Đang làm việc" />
                </MudItem>
            </MudGrid>

            <MudText Typo="Typo.subtitle2" Class="mt-3 mb-1">Vai trò</MudText>
            <div class="d-flex flex-wrap">
                <MudSwitch @bind-Value="_input.LaChuCoSo" Color="Color.Primary" Label="Chủ cơ sở" Class="mr-4" />
                <MudSwitch @bind-Value="_input.LaNguoiCheBien" Color="Color.Primary" Label="Người chế biến" Class="mr-4" />
                <MudSwitch @bind-Value="_input.LaNguoiGiaoHang" Color="Color.Primary" Label="Người giao hàng (shipper)" />
            </div>

            @if (_input.LaNguoiGiaoHang)
            {
                <MudGrid Class="mt-1">
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_input.PhuongTien" Label="Loại phương tiện"
                                      Variant="Variant.Outlined" MaxLength="255"
                                      HelperText="vd: Xe máy, ô tô tải." />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_input.BienSo" Label="Biển số xe"
                                      Variant="Variant.Outlined" MaxLength="50" />
                    </MudItem>
                </MudGrid>
            }
        </MudForm>

        <MudDivider Class="my-4" />

        <MudText Typo="Typo.subtitle2" Class="mb-1">Giấy khám sức khoẻ</MudText>
        <MudText Typo="Typo.caption" Class="mud-text-secondary mb-2 d-block">
            Không bắt buộc, nhưng đã khai thì phải đủ số giấy, ngày khám và ngày hết hạn.
        </MudText>
        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_input.KskSoGiay" Label="Số giấy"
                              Variant="Variant.Outlined" MaxLength="255" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_input.KskNoiKham" Label="Nơi khám"
                              Variant="Variant.Outlined" MaxLength="255" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudDatePicker @bind-Date="_kskNgayKham" Label="Ngày khám"
                               Variant="Variant.Outlined" DateFormat="dd/MM/yyyy" Editable="true" Mask="@(new DateMask("dd/MM/yyyy"))" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudDatePicker @bind-Date="_kskNgayHetHan" Label="Ngày hết hạn"
                               Variant="Variant.Outlined" DateFormat="dd/MM/yyyy" Editable="true" Mask="@(new DateMask("dd/MM/yyyy"))" />
            </MudItem>
        </MudGrid>

        <MudText Typo="Typo.subtitle2" Class="mb-1 mt-4">Chứng nhận tập huấn ATTP</MudText>
        <MudText Typo="Typo.caption" Class="mud-text-secondary mb-2 d-block">
            Không bắt buộc, nhưng đã khai thì phải đủ số chứng nhận và ngày cấp.
        </MudText>
        <MudGrid>
            <MudItem xs="12" sm="4">
                <MudTextField @bind-Value="_input.AttpSoChungNhan" Label="Số chứng nhận"
                              Variant="Variant.Outlined" MaxLength="255" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudDatePicker @bind-Date="_attpNgayCap" Label="Ngày cấp"
                               Variant="Variant.Outlined" DateFormat="dd/MM/yyyy" Editable="true" Mask="@(new DateMask("dd/MM/yyyy"))" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudTextField @bind-Value="_input.AttpCoQuanCap" Label="Cơ quan cấp"
                              Variant="Variant.Outlined" MaxLength="255" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _hienForm = false)">Huỷ</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   Disabled="_dangLuu" OnClick="LuuAsync">Lưu</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<Staff> _danhSach = new();
    private bool _dangTai = true;
    private bool _dangLuu;

    private MudForm? _form;
    private bool _hienForm;
    private bool _dangSua;
    private Staff _input = new();

    // MudDatePicker dùng DateTime?, entity dùng DateOnly? theo đúng kiểu date của đặc tả.
    private DateTime? _ngaySinh;
    private DateTime? _kskNgayKham;
    private DateTime? _kskNgayHetHan;
    private DateTime? _attpNgayCap;

    private readonly DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Medium, FullWidth = true };

    protected override async Task OnInitializedAsync() => await TaiDanhSachAsync();

    private async Task TaiDanhSachAsync()
    {
        _dangTai = true;
        _danhSach = (await NhanSuService.LayTatCaAsync()).ToList();
        _dangTai = false;
    }

    /// <summary>Cảnh báo giấy khám sức khoẻ đã hết hạn hoặc sắp hết hạn trong 30 ngày.</summary>
    private static string? CanhBaoKsk(Staff ns)
    {
        if (ns.KskNgayHetHan is not { } het) return null;

        var homNay = DateOnly.FromDateTime(DateTime.Today);
        if (het < homNay) return "KSK đã hết hạn";
        if (het <= homNay.AddDays(30)) return "KSK sắp hết hạn";
        return null;
    }

    private void MoForm(Staff? ns)
    {
        _dangSua = ns is not null;

        if (ns is null)
        {
            _input = new Staff();
            _ngaySinh = _kskNgayKham = _kskNgayHetHan = _attpNgayCap = null;
        }
        else
        {
            // Sao chép sang đối tượng riêng để bấm Huỷ không làm bẩn dữ liệu đang hiển thị.
            _input = new Staff
            {
                Id = ns.Id,
                MaNhanSu = ns.MaNhanSu,
                HoTen = ns.HoTen,
                ViTri = ns.ViTri,
                NgaySinh = ns.NgaySinh,
                DiaChi = ns.DiaChi,
                DienThoai = ns.DienThoai,
                Cccd = ns.Cccd,
                LaChuCoSo = ns.LaChuCoSo,
                LaNguoiCheBien = ns.LaNguoiCheBien,
                LaNguoiGiaoHang = ns.LaNguoiGiaoHang,
                PhuongTien = ns.PhuongTien,
                BienSo = ns.BienSo,
                TrangThai = ns.TrangThai,
                KskSoGiay = ns.KskSoGiay,
                KskNoiKham = ns.KskNoiKham,
                AttpSoChungNhan = ns.AttpSoChungNhan,
                AttpCoQuanCap = ns.AttpCoQuanCap
            };

            _ngaySinh = ns.NgaySinh?.ToDateTime(TimeOnly.MinValue);
            _kskNgayKham = ns.KskNgayKham?.ToDateTime(TimeOnly.MinValue);
            _kskNgayHetHan = ns.KskNgayHetHan?.ToDateTime(TimeOnly.MinValue);
            _attpNgayCap = ns.AttpNgayCap?.ToDateTime(TimeOnly.MinValue);
        }

        _hienForm = true;
    }

    private async Task LuuAsync()
    {
        if (_form is not null)
        {
            await _form.Validate();
            if (!_form.IsValid) return;
        }

        _input.NgaySinh = _ngaySinh is { } a ? DateOnly.FromDateTime(a) : null;
        _input.KskNgayKham = _kskNgayKham is { } b ? DateOnly.FromDateTime(b) : null;
        _input.KskNgayHetHan = _kskNgayHetHan is { } c ? DateOnly.FromDateTime(c) : null;
        _input.AttpNgayCap = _attpNgayCap is { } d ? DateOnly.FromDateTime(d) : null;

        // Xoá thông tin shipper nếu không còn là người giao hàng.
        if (!_input.LaNguoiGiaoHang)
        {
            _input.PhuongTien = null;
            _input.BienSo = null;
        }

        _dangLuu = true;
        var ketQua = _dangSua
            ? await NhanSuService.CapNhatAsync(_input)
            : await NhanSuService.ThemAsync(_input);
        _dangLuu = false;

        Snackbar.Add(ketQua.ThongBao, ketQua.ThanhCong ? Severity.Success : Severity.Error);

        if (ketQua.ThanhCong)
        {
            _hienForm = false;
            await TaiDanhSachAsync();
        }
    }

    private async Task XacNhanXoaAsync(Staff ns)
    {
        var dongY = await DialogService.ShowMessageBox(
            "Xác nhận xoá",
            $"Xoá nhân sự \"{ns.HoTen}\" ({ns.MaNhanSu})?",
            yesText: "Xoá", cancelText: "Huỷ");

        if (dongY != true) return;

        var ketQua = await NhanSuService.XoaAsync(ns.Id);
        Snackbar.Add(ketQua.ThongBao, ketQua.ThanhCong ? Severity.Success : Severity.Error);

        if (ketQua.ThanhCong) await TaiDanhSachAsync();
    }
}
