@page "/app/don-hang-nhan"
@using HCP.Domain.Constants
@using HCP.Infrastructure.Services.DonHangNhan
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = AppRoles.TenantAdmin + "," + AppRoles.TenantStaff)]
@inject IDonHangNhanService DonHangNhanService
@inject ISnackbar Snackbar

<PageTitle>Đơn hàng từ trường</PageTitle>

<div class="d-flex justify-space-between align-center mb-4">
    <div>
        <MudText Typo="Typo.h5">Đơn hàng từ trường</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            Đơn do trường học đặt, tự động kéo về từ HanoiCheck (mỗi 15 phút). Bấm "Đồng bộ ngay" để cập nhật thủ công.
        </MudText>
    </div>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CloudDownload"
               Disabled="_dangDongBo" OnClick="DongBoNgayAsync">Đồng bộ ngay</MudButton>
</div>

@if (_dangTai)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_danhSach.Count == 0)
{
    <MudAlert Severity="Severity.Info">
        Chưa có đơn hàng nào. Bấm <b>"Đồng bộ ngay"</b> để kéo về (cần đã cấu hình kết nối HanoiCheck).
    </MudAlert>
}
else
{
    <MudTable Items="_danhSach" Hover="true" Elevation="1" Dense="true">
        <HeaderContent>
            <MudTh Style="width:56px">STT</MudTh>
            <MudTh>Mã đơn</MudTh>
            <MudTh>Trường học</MudTh>
            <MudTh>Trạng thái</MudTh>
            <MudTh>Ngày giao</MudTh>
            <MudTh>Sản phẩm</MudTh>
            <MudTh>Đồng bộ lúc</MudTh>
            <MudTh Style="width:60px"></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="STT">@(_danhSach.IndexOf(context)+1)</MudTd>
            <MudTd DataLabel="Mã đơn"><b>@context.MaDonHang</b></MudTd>
            <MudTd DataLabel="Trường học">@(context.TenTruong ?? "-")</MudTd>
            <MudTd DataLabel="Trạng thái">
                <MudChip T="string" Size="Size.Small" Color="MauTrangThai(context.TrangThai)">
                    @TenTrangThai(context.TrangThai)
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Ngày giao">@(context.NgayGiao?.ToString("dd/MM/yyyy") ?? "-")</MudTd>
            <MudTd DataLabel="Sản phẩm">
                @if (context.Dong.Count == 0)
                {
                    <span class="mud-text-secondary">-</span>
                }
                else
                {
                    <MudText Typo="Typo.body2">
                        @string.Join(", ", context.Dong.Select(d => d.TenSanPham ?? d.MaSanPham))
                    </MudText>
                }
            </MudTd>
            <MudTd DataLabel="Đồng bộ lúc">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    @context.LanDongBoUtc.ToLocalTime().ToString("dd/MM HH:mm")
                </MudText>
            </MudTd>
            <MudTd>
                <MudTooltip Text="Xem chi tiết đơn">
                    <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small"
                                   Color="Color.Primary" OnClick="@(() => MoChiTiet(context))" />
                </MudTooltip>
            </MudTd>
        </RowTemplate>
    </MudTable>
}

<MudDialog @bind-Visible="_hienChiTiet" Options="_dialogOptions">
    <TitleContent><MudText Typo="Typo.h6">Chi tiết đơn @_chon?.MaDonHang</MudText></TitleContent>
    <DialogContent>
        @if (_chon is not null)
        {
            <MudGrid Class="mb-2" Spacing="1">
                <MudItem xs="12" sm="6"><b>Trường:</b> @(_chon.TenTruong ?? "-")</MudItem>
                <MudItem xs="12" sm="6"><b>Trạng thái:</b> @TenTrangThai(_chon.TrangThai)</MudItem>
                <MudItem xs="12" sm="6"><b>Ngày giao:</b> @(_chon.NgayGiao?.ToString("dd/MM/yyyy") ?? "-")</MudItem>
                <MudItem xs="12" sm="6"><b>Điểm trường:</b> @(_chon.DiemTruong ?? "-")</MudItem>
                <MudItem xs="12" sm="6"><b>Loại đơn:</b> @(_chon.LoaiDon ?? "-")</MudItem>
                <MudItem xs="12" sm="6"><b>Trường tạo đơn lúc:</b> @(_chon.NgayTaoTrenHnC?.ToString("dd/MM/yyyy HH:mm") ?? "-")</MudItem>
                <MudItem xs="12" sm="6"><b>Kho xuất:</b> @(_chon.KhoXuat ?? "-")</MudItem>
                <MudItem xs="12" sm="6"><b>Địa chỉ giao:</b> @(_chon.DiaChiGiao ?? "-")</MudItem>
                <MudItem xs="12">
                    <b>Người giao:</b>
                    @if (string.IsNullOrEmpty(_chon.TenNguoiGiao) && string.IsNullOrEmpty(_chon.MaNguoiGiao))
                    {
                        <span class="mud-text-secondary">Chưa phân công</span>
                    }
                    else
                    {
                        <span>
                            @(_chon.TenNguoiGiao ?? _chon.MaNguoiGiao)
                            @if (!string.IsNullOrEmpty(_chon.TenNguoiGiao) && !string.IsNullOrEmpty(_chon.MaNguoiGiao))
                            {
                                <span class="mud-text-secondary">(@_chon.MaNguoiGiao)</span>
                            }
                            @if (!string.IsNullOrEmpty(_chon.SdtNguoiGiao))
                            {
                                <span> · @_chon.SdtNguoiGiao</span>
                            }
                            @if (!string.IsNullOrEmpty(_chon.PhuongTienGiao) || !string.IsNullOrEmpty(_chon.BienSoXe))
                            {
                                <span> · @_chon.PhuongTienGiao @_chon.BienSoXe</span>
                            }
                        </span>
                    }
                </MudItem>
                @if (!string.IsNullOrEmpty(_chon.GhiChu))
                {
                    <MudItem xs="12"><b>Ghi chú:</b> @_chon.GhiChu</MudItem>
                }
                @* Chỉ nhận http(s) - link lấy từ dữ liệu ngoài, không để lọt javascript: *@
                @if (_chon.LinkTruyXuat is { } link && (link.StartsWith("https://") || link.StartsWith("http://")))
                {
                    <MudItem xs="12">
                        <b>Truy xuất:</b>
                        <MudLink Href="@_chon.LinkTruyXuat" Target="_blank" Typo="Typo.body2">Mở trang truy xuất trên HanoiCheck</MudLink>
                    </MudItem>
                }
            </MudGrid>
            @if (!_chon.DaLayChiTiet)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                    Chưa lấy được chi tiết đầy đủ (số lượng, phân bổ lô/kho) - sẽ tự cập nhật ở lần đồng bộ sau.
                </MudAlert>
            }
            <MudText Typo="Typo.subtitle2" Class="mb-1">Dòng hàng</MudText>
            <MudTable Items="_chon.Dong" Dense="true" Elevation="0">
                <HeaderContent>
                    <MudTh>Mã</MudTh>
                    <MudTh>Tên</MudTh>
                    <MudTh Style="text-align:right">Số lượng</MudTh>
                    <MudTh>Phân bổ (NCC · lô · kho · SL)</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Mã">@context.MaSanPham</MudTd>
                    <MudTd DataLabel="Tên">@context.TenSanPham</MudTd>
                    <MudTd DataLabel="Số lượng" Style="text-align:right">@(context.SoLuong?.ToString("0.###") ?? "-")</MudTd>
                    <MudTd DataLabel="Phân bổ">
                        @if (context.PhanBo.Count == 0)
                        {
                            <span class="mud-text-secondary">-</span>
                        }
                        else
                        {
                            @foreach (var pb in context.PhanBo)
                            {
                                <MudText Typo="Typo.caption" Class="d-block">
                                    @(pb.MaThucPhamNcc ?? "?") · lô @(pb.MaLo ?? "-") · kho @(pb.MaKho ?? "-") · @(pb.SoLuong?.ToString("0.###") ?? "-")
                                </MudText>
                            }
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _hienChiTiet = false)">Đóng</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<HCP.Domain.Entities.Business.DonHangNhan> _danhSach = new();
    private bool _dangTai = true;
    private bool _dangDongBo;

    private bool _hienChiTiet;
    private HCP.Domain.Entities.Business.DonHangNhan? _chon;
    private readonly DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Medium, FullWidth = true };

    private void MoChiTiet(HCP.Domain.Entities.Business.DonHangNhan don)
    {
        _chon = don;
        _hienChiTiet = true;
    }

    protected override async Task OnInitializedAsync() => await TaiAsync();

    private async Task TaiAsync()
    {
        _dangTai = true;
        _danhSach = (await DonHangNhanService.LayTatCaAsync()).ToList();
        _dangTai = false;
    }

    private async Task DongBoNgayAsync()
    {
        _dangDongBo = true;
        var kq = await DonHangNhanService.DongBoNgayAsync();
        _dangDongBo = false;

        if (kq.ChuaCauHinh)
            Snackbar.Add("Chưa cấu hình kết nối HanoiCheck. Vào Cài đặt kết nối để khai báo.", Severity.Warning);
        else if (!kq.ThanhCong)
            Snackbar.Add(kq.ThongBao ?? "Đồng bộ đơn hàng thất bại.", Severity.Error);
        else
            Snackbar.Add($"Đã đồng bộ {kq.SoDon} đơn hàng từ HanoiCheck.", Severity.Success);

        if (kq.ThanhCong) await TaiAsync();
    }

    // Các mã trạng thái đơn theo đặc tả HnC.
    private static string TenTrangThai(string? s) => s switch
    {
        "CHO_XAC_NHAN" => "Chờ xác nhận",
        "TU_CHOI" => "Từ chối",
        "DANG_CHUAN_BI" => "Đang chuẩn bị",
        "DANG_GIAO" => "Đang giao",
        "DA_GIAO" => "Đã giao",
        "GIAO_HANG_THANH_CONG" => "Giao thành công",
        "TRA_HANG" => "Trả hàng",
        "HUY" => "Huỷ",
        _ => s ?? "-"
    };

    private static Color MauTrangThai(string? s) => s switch
    {
        "CHO_XAC_NHAN" => Color.Info,
        "DANG_CHUAN_BI" or "DANG_GIAO" => Color.Primary,
        "DA_GIAO" or "GIAO_HANG_THANH_CONG" => Color.Success,
        "TU_CHOI" or "HUY" or "TRA_HANG" => Color.Error,
        _ => Color.Default
    };
}
