@page "/app/thuc-pham"
@using HCP.Domain.Constants
@using HCP.Domain.Entities.Business
@using HCP.Domain.Enums
@using HCP.Infrastructure.Services.DanhMuc
@using HCP.Infrastructure.Sync
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = AppRoles.TenantAdmin + "," + AppRoles.TenantStaff)]
@inject IDanhMucService<Product> ThucPhamService
@inject IDanhMucService<ProductionProcess> QuyTrinhService
@inject IDanhMucChuanService DanhMucChuanService
@inject IStandardFoodsSyncJob StandardFoodsSyncJob
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Quản lý thực phẩm</PageTitle>

<div class="d-flex justify-space-between align-center mb-4">
    <div>
        <MudText Typo="Typo.h5">Quản lý thực phẩm / SKU</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            Danh mục thực phẩm ổn định của cơ sở, khai một lần rồi dùng lại cho các lô sản xuất.
            Đồng bộ sang HanoiCheck qua nghiệp vụ "Đồng bộ thực phẩm".
        </MudText>
    </div>
    <div class="d-flex flex-wrap">
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Class="mr-2 mb-2"
                   StartIcon="@Icons.Material.Filled.CloudSync" Disabled="_dangDongBoDanhMuc"
                   OnClick="CapNhatDanhMucChuanAsync">
            Cập nhật danh mục chuẩn
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mb-2"
                   StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => MoForm(null))">
            Thêm thực phẩm
        </MudButton>
    </div>
</div>

@if (_danhMucChuan.Count == 0 && !_dangTai)
{
    <MudAlert Severity="Severity.Warning" Class="mb-4" Dense="true">
        Chưa có danh mục thực phẩm chuẩn từ HanoiCheck. Ô "Loại thực phẩm" đang phải nhập tay và
        dễ sai mã (HnC sẽ báo lỗi 422). Hãy bấm <b>"Cập nhật danh mục chuẩn"</b> để tải về, sau đó
        chọn loại từ danh sách.
    </MudAlert>
}

@if (_dangTai)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_danhSach.Count == 0)
{
    <MudAlert Severity="Severity.Info">Chưa có thực phẩm nào.</MudAlert>
}
else
{
    <MudTable Items="_danhSach" Hover="true" Elevation="1" Dense="true">
        <HeaderContent>
            <MudTh>Mã SKU</MudTh>
            <MudTh>Tên thực phẩm</MudTh>
            <MudTh>Phân loại</MudTh>
            <MudTh>Danh mục chuẩn</MudTh>
            <MudTh>ĐVT</MudTh>
            <MudTh>Quy trình</MudTh>
            <MudTh Style="width:120px"></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Mã SKU"><b>@context.MaSanPham</b></MudTd>
            <MudTd DataLabel="Tên">@context.TenSanPham</MudTd>
            <MudTd DataLabel="Phân loại">
                @if (context.LoaiSanPham == LoaiSanPham.NguyenLieu)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning">Nguyên liệu</MudChip>
                }
                else
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary">Thành phẩm</MudChip>
                }
            </MudTd>
            <MudTd DataLabel="Danh mục chuẩn">@TenLoai(context.MaLoaiSp)</MudTd>
            <MudTd DataLabel="ĐVT">@context.DonViTinh</MudTd>
            <MudTd DataLabel="Quy trình">@context.MaQuyTrinh</MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                               OnClick="@(() => MoForm(context))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                               OnClick="@(() => XacNhanXoaAsync(context))" />
            </MudTd>
        </RowTemplate>
    </MudTable>
}

<MudDialog @bind-Visible="_hienForm" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">@(_dangSua ? "Sửa thực phẩm" : "Thêm thực phẩm")</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" Model="_input">
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_input.MaSanPham" Label="Mã SKU"
                                  Variant="Variant.Outlined" MaxLength="255"
                                  HelperText="Khoá nghiệp vụ, vd SP001."
                                  Required="true" RequiredError="Vui lòng nhập mã SKU" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_input.TenSanPham" Label="Tên thực phẩm"
                                  Variant="Variant.Outlined" MaxLength="255"
                                  Required="true" RequiredError="Vui lòng nhập tên" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudSelect T="LoaiSanPham" @bind-Value="_input.LoaiSanPham" Label="Loại"
                               Variant="Variant.Outlined">
                        <MudSelectItem T="LoaiSanPham" Value="LoaiSanPham.ThanhPham">Thành phẩm (để bán)</MudSelectItem>
                        <MudSelectItem T="LoaiSanPham" Value="LoaiSanPham.NguyenLieu">Nguyên liệu (đầu vào)</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_input.DonViTinh" Label="Đơn vị tính"
                                  Variant="Variant.Outlined" MaxLength="50"
                                  HelperText="vd kg, cái, quả. Dùng cho tồn kho." />
                </MudItem>

                @* Mã loại (danh mục chuẩn HnC) chỉ áp dụng cho THÀNH PHẨM. Không render với nguyên
                   liệu để khỏi vướng validation Required. *@
                @if (_input.LoaiSanPham == LoaiSanPham.ThanhPham)
                {
                    <MudItem xs="12" sm="6">
                        @if (_danhMucChuan.Count > 0)
                        {
                            <MudAutocomplete T="string" @bind-Value="_input.MaLoaiSp" Label="Loại thực phẩm"
                                             Variant="Variant.Outlined" Required="true"
                                             RequiredError="Vui lòng chọn loại thực phẩm"
                                             SearchFunc="TimLoaiThucPham" ToStringFunc="TenLoai"
                                             MaxItems="100" Clearable="true" ResetValueOnEmptyText="false"
                                             HelperText="Gõ mã hoặc tên để tìm nhanh." />
                        }
                        else
                        {
                            <MudTextField @bind-Value="_input.MaLoaiSp" Label="Mã loại thực phẩm"
                                          Variant="Variant.Outlined" MaxLength="100"
                                          HelperText="Danh mục chuẩn chưa đồng bộ - nhập mã tay, vd THIT."
                                          Required="true" RequiredError="Vui lòng nhập mã loại" />
                        }
                    </MudItem>
                }
                <MudItem xs="12" sm="6">
                    <MudSelect T="string" @bind-Value="_input.MaQuyTrinh" Label="Quy trình sản xuất"
                               Variant="Variant.Outlined" Clearable="true"
                               HelperText="Không bắt buộc.">
                        @foreach (var qt in _quyTrinh)
                        {
                            <MudSelectItem T="string" Value="@qt.MaQuyTrinh">
                                @qt.MaQuyTrinh — @qt.TenQuyTrinh
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_input.Gtin" Label="Mã vạch GTIN"
                                  Variant="Variant.Outlined" MaxLength="50" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_input.MaThucPhamChuan" Label="Mã thực phẩm chuẩn quốc gia"
                                  Variant="Variant.Outlined" MaxLength="100"
                                  HelperText="Nếu có, vd VN-0001." />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_input.QuocGia" Label="Quốc gia xuất xứ"
                                  Variant="Variant.Outlined" MaxLength="100" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_input.MoTa" Label="Mô tả"
                                  Variant="Variant.Outlined" MaxLength="2000" Lines="2" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _hienForm = false)">Huỷ</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   Disabled="_dangLuu" OnClick="LuuAsync">Lưu</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<Product> _danhSach = new();
    private List<StandardFoodCategory> _danhMucChuan = new();
    private List<ProductionProcess> _quyTrinh = new();

    private bool _dangTai = true;
    private bool _dangLuu;
    private bool _dangDongBoDanhMuc;

    private MudForm? _form;
    private bool _hienForm;
    private bool _dangSua;
    private Product _input = new();

    private readonly DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Medium, FullWidth = true };

    protected override async Task OnInitializedAsync() => await TaiDanhSachAsync();

    private async Task TaiDanhSachAsync()
    {
        _dangTai = true;
        _danhSach = (await ThucPhamService.LayTatCaAsync()).ToList();
        _danhMucChuan = (await DanhMucChuanService.LayTatCaAsync()).ToList();
        _quyTrinh = (await QuyTrinhService.LayTatCaAsync()).ToList();
        _dangTai = false;
    }

    private async Task CapNhatDanhMucChuanAsync()
    {
        _dangDongBoDanhMuc = true;
        try
        {
            var soLuong = await StandardFoodsSyncJob.DongBoAsync();
            if (soLuong > 0)
            {
                Snackbar.Add($"Đã cập nhật {soLuong} danh mục thực phẩm chuẩn từ HanoiCheck.", Severity.Success);
                _danhMucChuan = (await DanhMucChuanService.LayTatCaAsync()).ToList();
            }
            else
            {
                Snackbar.Add("Chưa lấy được danh mục. Kiểm tra lại kết nối HanoiCheck ở màn Cài đặt kết nối "
                           + "(cần đã cấu hình và xác thực thành công).", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Lỗi khi cập nhật danh mục: " + ex.Message, Severity.Error);
        }
        finally
        {
            _dangDongBoDanhMuc = false;
        }
    }

    // code ở đây là id danh mục (HnC trả code=null, ta lưu id vào Code). Hiển thị TÊN cho dễ đọc.
    private string TenLoai(string? code)
    {
        if (string.IsNullOrEmpty(code)) return string.Empty;
        var dm = _danhMucChuan.FirstOrDefault(x => x.Code == code);
        return dm is null ? code : dm.Name;
    }

    /// <summary>Lọc danh mục chuẩn theo mã hoặc tên; giới hạn 100 kết quả để dropdown mở nhanh.</summary>
    private Task<IEnumerable<string>> TimLoaiThucPham(string? value, CancellationToken ct)
    {
        IEnumerable<StandardFoodCategory> kq = _danhMucChuan;
        if (!string.IsNullOrWhiteSpace(value))
        {
            kq = kq.Where(c =>
                c.Code.Contains(value, StringComparison.OrdinalIgnoreCase)
                || (c.Name ?? "").Contains(value, StringComparison.OrdinalIgnoreCase));
        }
        return Task.FromResult(kq.Take(100).Select(c => c.Code));
    }

    private void MoForm(Product? sp)
    {
        _dangSua = sp is not null;

        _input = sp is null
            ? new Product()
            : new Product
            {
                Id = sp.Id,
                MaSanPham = sp.MaSanPham,
                TenSanPham = sp.TenSanPham,
                MaLoaiSp = sp.MaLoaiSp,
                MaThucPhamChuan = sp.MaThucPhamChuan,
                Gtin = sp.Gtin,
                QuocGia = sp.QuocGia,
                MoTa = sp.MoTa,
                MaQuyTrinh = sp.MaQuyTrinh,
                LoaiSanPham = sp.LoaiSanPham,
                DonViTinh = sp.DonViTinh
            };

        _hienForm = true;
    }

    private async Task LuuAsync()
    {
        if (_form is not null)
        {
            await _form.Validate();
            if (!_form.IsValid) return;
        }

        _dangLuu = true;
        var ketQua = _dangSua
            ? await ThucPhamService.CapNhatAsync(_input)
            : await ThucPhamService.ThemAsync(_input);
        _dangLuu = false;

        Snackbar.Add(ketQua.ThongBao, ketQua.ThanhCong ? Severity.Success : Severity.Error);

        if (ketQua.ThanhCong)
        {
            _hienForm = false;
            await TaiDanhSachAsync();
        }
    }

    private async Task XacNhanXoaAsync(Product sp)
    {
        var dongY = await DialogService.ShowMessageBox(
            "Xác nhận xoá",
            $"Xoá thực phẩm \"{sp.TenSanPham}\" ({sp.MaSanPham})?",
            yesText: "Xoá", cancelText: "Huỷ");

        if (dongY != true) return;

        var ketQua = await ThucPhamService.XoaAsync(sp.Id);
        Snackbar.Add(ketQua.ThongBao, ketQua.ThanhCong ? Severity.Success : Severity.Error);

        if (ketQua.ThanhCong) await TaiDanhSachAsync();
    }
}
