@page "/admin/co-so"
@using HCP.Domain.Constants
@using HCP.Domain.Entities.Infrastructure
@using HCP.Domain.Enums
@using HCP.Infrastructure.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = AppRoles.PlatformSuperAdmin)]
@inject ICoSoService CoSoService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Danh sách cơ sở</PageTitle>

<div class="d-flex justify-space-between align-center mb-4">
    <div>
        <MudText Typo="Typo.h5">Danh sách cơ sở</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            Toàn bộ cơ sở trên nền tảng, tình trạng kết nối HanoiCheck, chức năng được dùng và khoá/mở tài khoản.
        </MudText>
    </div>
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh"
               OnClick="TaiDanhSachAsync">Làm mới</MudButton>
</div>

@if (_dangTai)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_danhSach.Count == 0)
{
    <MudAlert Severity="Severity.Info">Chưa có cơ sở nào đăng ký.</MudAlert>
}
else
{
    <MudTable Items="_danhSach" Hover="true" Elevation="1" Dense="true">
        <HeaderContent>
            <MudTh Style="width:56px">STT</MudTh>
            <MudTh>Tên cơ sở</MudTh>
            <MudTh>Mã số thuế</MudTh>
            <MudTh>Email</MudTh>
            <MudTh>Trạng thái</MudTh>
            <MudTh>Kết nối HnC</MudTh>
            <MudTh>Chức năng</MudTh>
            <MudTh Style="width:220px"></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="STT">@(_danhSach.IndexOf(context)+1)</MudTd>
            <MudTd DataLabel="Tên cơ sở">
                <b>@context.Name</b>
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">@context.DiaChi</MudText>
            </MudTd>
            <MudTd DataLabel="Mã số thuế">@context.MaSoThue</MudTd>
            <MudTd DataLabel="Email">@context.EmailLienHe</MudTd>
            <MudTd DataLabel="Trạng thái">
                <MudChip T="string" Size="Size.Small" Color="@MauTrangThai(context.TrangThai)">
                    @NhanTrangThai(context.TrangThai)
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Kết nối HnC">
                @if (_ketNoi.TryGetValue(context.Id!, out var daXacThuc))
                {
                    @if (daXacThuc)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Success"
                                 Icon="@Icons.Material.Filled.CheckCircle">Đã kết nối</MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning">Chưa xác thực</MudChip>
                    }
                }
                else
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Chưa cấu hình</MudText>
                }
            </MudTd>
            <MudTd DataLabel="Chức năng">
                @{ var ds = ChucNang.Tach(context.ChucNangCsv); }
                @if (ds.Count == 0)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Cơ bản</MudText>
                }
                else
                {
                    @foreach (var ma in ds)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@ChucNang.Ten(ma)</MudChip>
                    }
                }
            </MudTd>
            <MudTd>
                @if (context.TrangThai != TenantStatus.Rejected)
                {
                    <MudButton Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined" Class="mr-1"
                               StartIcon="@Icons.Material.Filled.Tune" Disabled="_dangXuLy"
                               OnClick="@(() => MoChucNang(context))">Chức năng</MudButton>
                }
                @if (context.TrangThai == TenantStatus.Active)
                {
                    <MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Filled.Lock" Disabled="_dangXuLy"
                               OnClick="@(() => KhoaAsync(context))">Khoá</MudButton>
                }
                else if (context.TrangThai == TenantStatus.Suspended)
                {
                    <MudButton Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Filled.LockOpen" Disabled="_dangXuLy"
                               OnClick="@(() => MoKhoaAsync(context))">Mở khoá</MudButton>
                }
                else if (context.TrangThai == TenantStatus.PendingApproval)
                {
                    <MudButton Size="Size.Small" Href="/admin/duyet-dang-ky" Variant="Variant.Text">Đi duyệt</MudButton>
                }
            </MudTd>
        </RowTemplate>
    </MudTable>
}

<MudDialog @bind-Visible="_hienChucNang" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">Chức năng của "@_coSoDangSua?.Name"</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-2">
            Danh mục cơ bản (Tổng quan, Kho, Cơ sở SX, Khâu, Quy trình, NCC đầu vào, Nhân sự, Thực phẩm) luôn có.
            Tắt chức năng chỉ ẩn và chặn truy cập, không xoá dữ liệu.
        </MudText>
        <div class="d-flex flex-wrap gap-2 mb-3">
            <MudText Typo="Typo.caption" Class="align-self-center">Gói mẫu:</MudText>
            @foreach (var goi in ChucNang.GoiMau)
            {
                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                           OnClick="@(() => ApGoi(goi.Ma))">@goi.Ten</MudButton>
            }
        </div>
        @foreach (var cn in ChucNang.DanhSach)
        {
            <div class="mb-1">
                <MudCheckBox T="bool" Value="@_chon.Contains(cn.Ma)" ValueChanged="@(v => DoiChon(cn.Ma, v))"
                             Color="Color.Primary" Dense="true" Label="@cn.Ten" />
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block" Style="margin-left:34px;margin-top:-6px">
                    @cn.MoTa@(cn.PhuThuoc.Count > 0 ? $" — cần {string.Join(", ", cn.PhuThuoc.Select(ChucNang.Ten))}" : "")
                </MudText>
            </div>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _hienChucNang = false)">Huỷ</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="_dangXuLy"
                   OnClick="LuuChucNangAsync">Lưu</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private List<Tenant> _danhSach = new();
    private IReadOnlyDictionary<string, bool> _ketNoi = new Dictionary<string, bool>();
    private bool _dangTai = true;
    private bool _dangXuLy;

    private bool _hienChucNang;
    private Tenant? _coSoDangSua;
    private HashSet<string> _chon = new();
    private readonly DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true };

    private void MoChucNang(Tenant coSo)
    {
        _coSoDangSua = coSo;
        _chon = ChucNang.Tach(coSo.ChucNangCsv).ToHashSet();
        _hienChucNang = true;
    }

    private void ApGoi(IReadOnlyList<string> ma) => _chon = ChucNang.Tach(ChucNang.Ghep(ma)).ToHashSet();

    /// <summary>Bật thì kéo theo module phụ thuộc; tắt thì tắt luôn các module cần nó.</summary>
    private void DoiChon(string ma, bool bat)
    {
        if (bat)
        {
            _chon = ChucNang.Tach(ChucNang.Ghep(_chon.Append(ma))).ToHashSet();
            return;
        }
        var bo = new Queue<string>([ma]);
        while (bo.TryDequeue(out var m))
        {
            if (!_chon.Remove(m)) continue;
            foreach (var c in ChucNang.DanhSach.Where(c => c.PhuThuoc.Contains(m))) bo.Enqueue(c.Ma);
        }
    }

    private async Task LuuChucNangAsync()
    {
        if (_coSoDangSua is null) return;
        _dangXuLy = true;
        var kq = await CoSoService.CapNhatChucNangAsync(_coSoDangSua.Id!, _chon, await LayTenNguoiThucHienAsync());
        _dangXuLy = false;
        Snackbar.Add(kq.ThongBao, kq.ThanhCong ? Severity.Success : Severity.Error);
        if (!kq.ThanhCong) return;
        _hienChucNang = false;
        await TaiDanhSachAsync();
    }

    protected override async Task OnInitializedAsync() => await TaiDanhSachAsync();

    private async Task TaiDanhSachAsync()
    {
        _dangTai = true;
        _danhSach = (await CoSoService.LayDanhSachAsync()).ToList();
        _ketNoi = await CoSoService.LayTrangThaiKetNoiAsync();
        _dangTai = false;
    }

    private static string NhanTrangThai(TenantStatus tt) => tt switch
    {
        TenantStatus.PendingApproval => "Chờ duyệt",
        TenantStatus.Active => "Đang hoạt động",
        TenantStatus.Suspended => "Đã khoá",
        TenantStatus.Rejected => "Đã từ chối",
        _ => tt.ToString()
    };

    private static Color MauTrangThai(TenantStatus tt) => tt switch
    {
        TenantStatus.Active => Color.Success,
        TenantStatus.PendingApproval => Color.Info,
        TenantStatus.Suspended => Color.Error,
        TenantStatus.Rejected => Color.Default,
        _ => Color.Default
    };

    private async Task<string> LayTenNguoiThucHienAsync()
    {
        if (AuthState is null) return "unknown";
        var state = await AuthState;
        return state.User.Identity?.Name ?? "unknown";
    }

    private async Task KhoaAsync(Tenant coSo)
    {
        var dongY = await DialogService.ShowMessageBox(
            "Xác nhận khoá",
            $"Khoá cơ sở \"{coSo.Name}\"? Cơ sở sẽ không đăng nhập được cho tới khi mở lại.",
            yesText: "Khoá", cancelText: "Huỷ");
        if (dongY != true) return;

        _dangXuLy = true;
        var kq = await CoSoService.KhoaAsync(coSo.Id!, await LayTenNguoiThucHienAsync());
        _dangXuLy = false;
        Snackbar.Add(kq.ThongBao, kq.ThanhCong ? Severity.Success : Severity.Error);
        if (kq.ThanhCong) await TaiDanhSachAsync();
    }

    private async Task MoKhoaAsync(Tenant coSo)
    {
        _dangXuLy = true;
        var kq = await CoSoService.MoKhoaAsync(coSo.Id!, await LayTenNguoiThucHienAsync());
        _dangXuLy = false;
        Snackbar.Add(kq.ThongBao, kq.ThanhCong ? Severity.Success : Severity.Error);
        if (kq.ThanhCong) await TaiDanhSachAsync();
    }
}
