@page "/"
@using HCP.Domain.Constants

<PageTitle>Trang chủ</PageTitle>

<AuthorizeView>
    <Authorized>
        <MudText Typo="Typo.h5" Class="mb-4">
            Xin chào, @(context.User.FindFirst("hoTen")?.Value ?? context.User.Identity?.Name)
        </MudText>

        <AuthorizeView Roles="@AppRoles.PlatformSuperAdmin" Context="adminContext">
            <MudPaper Class="pa-5 mb-4" Elevation="1">
                <MudText Typo="Typo.subtitle1" Class="mb-2">Quản trị nền tảng</MudText>
                <MudText Typo="Typo.body2" Class="mb-3 mud-text-secondary">
                    Duyệt hồ sơ đăng ký của các cơ sở sản xuất và theo dõi tình trạng kết nối.
                </MudText>
                <MudButton Href="/admin/dashboard" Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Dashboard" Class="mr-2">
                    Giám sát hệ thống
                </MudButton>
                <MudButton Href="/admin/duyet-dang-ky" Variant="Variant.Outlined" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.FactCheck">
                    Duyệt đăng ký
                </MudButton>
            </MudPaper>
        </AuthorizeView>

        <AuthorizeView Roles="@AppRoles.TenantAdmin" Context="tenantContext">
            <MudPaper Class="pa-5 mb-4" Elevation="1">
                <MudText Typo="Typo.subtitle1" Class="mb-2">Cơ sở của bạn</MudText>
                <MudText Typo="Typo.body2" Class="mb-3 mud-text-secondary">
                    Trước khi dữ liệu được đồng bộ sang HanoiCheck, cơ sở cần khai báo bộ mã xác thực
                    do HanoiCheck cấp riêng cho mình.
                </MudText>
                <MudButton Href="/app/dashboard" Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Dashboard" Class="mr-2">
                    Tổng quan cơ sở
                </MudButton>
                <MudButton Href="/app/cai-dat-ket-noi" Variant="Variant.Outlined" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Link">
                    Cài đặt kết nối HanoiCheck
                </MudButton>
            </MudPaper>
        </AuthorizeView>

        <AuthorizeView Roles="@(AppRoles.TenantSanXuat + "," + AppRoles.TenantGiaoHang)" Context="nhanVienContext">
            <MudPaper Class="pa-5 mb-4" Elevation="1">
                <MudText Typo="Typo.subtitle1" Class="mb-3">Công việc của bạn</MudText>
                <AuthorizeView Roles="@AppRoles.TenantSanXuat" Context="sx">
                    <MudButton Href="/app/lenh-san-xuat" Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Factory" Class="mr-2 mb-2">Lệnh sản xuất</MudButton>
                </AuthorizeView>
                <AuthorizeView Roles="@AppRoles.TenantGiaoHang" Context="gh">
                    <MudButton Href="/app/don-hang-ban" Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.LocalShipping" Class="mr-2 mb-2">Đơn hàng cần giao</MudButton>
                </AuthorizeView>
            </MudPaper>
        </AuthorizeView>
    </Authorized>

    <NotAuthorized>
        <MudText Typo="Typo.h5" Class="mb-2">Hệ thống quản lý quy trình sản xuất</MudText>
        <MudText Typo="Typo.body1" Class="mb-4 mud-text-secondary">
            Nền tảng giúp các cơ sở sản xuất suất ăn, bánh ngọt, bánh mì... quản lý quy trình sản xuất
            và đồng bộ dữ liệu sang hệ thống HanoiCheck.
        </MudText>

        <MudButton Href="/dang-nhap" Variant="Variant.Filled" Color="Color.Primary" Class="mr-2">
            Đăng nhập
        </MudButton>
        <MudButton Href="/dang-ky" Variant="Variant.Outlined" Color="Color.Primary">
            Đăng ký cơ sở sản xuất
        </MudButton>
    </NotAuthorized>
</AuthorizeView>
